<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đổi mật khẩu</title>

  <!-- ✅ Thêm Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 font-sans">

  <div class="max-w-6xl mx-auto bg-white rounded shadow p-8 mt-10">
    <h2 class="text-2xl font-bold text-yellow-600 mb-6">
      🔐 Đổi mật khẩu (<%= user.VAI_TRO === 'admin' ? 'Admin' : 'Người dùng' %>)
    </h2>

    <% if (error) { %>
      <div class="bg-red-100 text-red-700 p-3 rounded mb-4"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="bg-green-100 text-green-700 p-3 rounded mb-4"><%= success %></div>
    <% } %>

    <form method="POST" action="/doi-mat-khau" class="space-y-4">
      <div>
        <label class="block mb-1 text-sm font-medium text-gray-700">Mật khẩu hiện tại</label>
        <input type="password" name="matKhauCu" required class="w-full border border-gray-300 rounded px-3 py-2" />
      </div>

      <div>
        <label class="block mb-1 text-sm font-medium text-gray-700">Mật khẩu mới</label>
        <input type="password" name="matKhauMoi" required class="w-full border border-gray-300 rounded px-3 py-2" />
      </div>

      <div>
        <label class="block mb-1 text-sm font-medium text-gray-700">Xác nhận mật khẩu mới</label>
        <input type="password" name="xacNhanMatKhau" required class="w-full border border-gray-300 rounded px-3 py-2" />
      </div>

      <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-600 text-white py-2 rounded">
        Cập nhật mật khẩu
      </button>
    </form>
  </div>

</body>
</html>
