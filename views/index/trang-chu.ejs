<div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">

  <section class="relative w-full h-[450px] md:h-[550px] bg-cover bg-center flex items-center justify-center text-center rounded-3xl overflow-hidden shadow-2xl mb-12"
    style="background-image: url('https://images.pexels.com/photos/4551832/pexels-photo-4551832.jpeg');">
    <div class="absolute inset-0 bg-black bg-opacity-60 flex items-center justify-center">
      <div class="p-6 md:p-10 max-w-2xl text-white">
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-4 animate__animated animate__fadeInDown">
          Khám phá Thế Giới Ẩm Thực Tuyệt Vời
        </h1>
        <p class="text-lg md:text-xl text-gray-200 mb-6 animate__animated animate__fadeInUp animate__delay-0-5s">
          Hàng ngàn công thức nấu ăn ngon miệng, dễ làm, đang chờ bạn khám phá và chinh phục.
        </p>
        <a href="/cong-thuc"
          class="inline-block bg-amber-500 text-white px-8 py-4 rounded-full text-lg font-bold shadow-lg hover:bg-amber-600 transition-all duration-300 transform hover:scale-105 animate__animated animate__zoomIn animate__delay-1s">
          Bắt đầu nấu ngay <i class="fas fa-arrow-right ml-2"></i>
        </a>
      </div>
    </div>
  </section>

  <form action="/cong-thuc" method="GET" class="mb-12 -mt-20 relative z-10 max-w-3xl mx-auto">
    <div class="flex rounded-full border-4 border-white shadow-xl overflow-hidden bg-white">
      <input name="search" type="text" placeholder="Tìm công thức theo tên món ăn, nguyên liệu, hoặc loại hình..."
        class="w-full px-6 py-3 md:py-4 text-lg text-gray-700 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent rounded-l-full" />
      <button type="submit"
        class="bg-amber-500 text-white px-6 md:px-8 hover:bg-amber-600 transition-colors duration-300 flex items-center justify-center rounded-r-full">
        <i class="fas fa-search text-xl"></i>
      </button>
    </div>
  </form>

  <section class="mb-16">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-3xl font-bold text-gray-800">Khám phá Danh mục</h2>
      <a href="/danh-muc" class="text-lg text-amber-600 hover:text-amber-700 transition-colors duration-200 flex items-center">
        Xem tất cả <i class="fas fa-chevron-right ml-2 text-sm"></i>
      </a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
      <% categories.slice(0, 6).forEach(cat => { %>
        <a href="/danh-muc/<%= cat.SLUG_LM %>"
          class="group block bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1 relative">
          <% if (cat.HINH_ANH_LM_URL) { %>
            <div class="h-36 md:h-40 overflow-hidden">
              <img src="<%= cat.HINH_ANH_LM_URL %>" alt="<%= cat.TEN_LM %>"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
            </div>
          <% } else { %>
            <div class="w-full h-36 md:h-40 bg-gray-100 flex items-center justify-center text-gray-400 text-base">
              <i class="fas fa-utensils text-3xl"></i>
            </div>
          <% } %>
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black via-black/70 to-transparent p-3 text-center">
            <h3 class="font-bold text-lg text-white group-hover:text-amber-400 transition-colors duration-200">
              <%= cat.TEN_LM %>
            </h3>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="mb-16">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-3xl font-bold text-gray-800">Công thức mới nhất</h2>
      <a href="/mon-an" class="text-lg text-amber-600 hover:text-amber-700 transition-colors duration-200 flex items-center">
        Xem tất cả <i class="fas fa-chevron-right ml-2 text-sm"></i>
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <% monAnMoi.forEach(mon => { %>
        <%- include("../partials/mon-an-card", { mon: mon }) %>
      <% }) %>
    </div>
  </section>

  <section class="mb-16">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-3xl font-bold text-gray-800">Công thức nổi bật</h2>
      <a href="/cong-thuc" class="text-lg text-amber-600 hover:text-amber-700 transition-colors duration-200 flex items-center">
        Khám phá thêm <i class="fas fa-chevron-right ml-2 text-sm"></i>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% recipesHot.forEach(recipe => { %>
        <%- include("../partials/recipeCard", { recipe: recipe }) %>
      <% }) %>
    </div>
  </section>

  <section class="bg-amber-50 border-t-4 border-amber-300 p-8 rounded-xl shadow-lg text-center mb-12">
    <h3 class="text-3xl font-bold text-gray-800 mb-4">Bạn có một công thức tuyệt vời muốn chia sẻ?</h3>
    <p class="text-lg text-gray-600 mb-6 max-w-2xl mx-auto">
      Hãy tham gia cộng đồng của chúng tôi! Đăng tải công thức của bạn và truyền cảm hứng cho hàng ngàn người yêu bếp khác.
    </p>
    <a href="/dang-cong-thuc"
      class="inline-block bg-amber-500 text-white px-8 py-4 rounded-full hover:bg-amber-600 transition-all duration-300 font-bold text-xl shadow-lg transform hover:scale-105">
      <i class="fa-solid fa-plus mr-3"></i>Đăng công thức ngay
    </a>
  </section>

</div>