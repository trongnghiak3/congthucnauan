<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description"
        content="Khám phá danh sách công thức nấu ăn ngon tại KemRecipe - từ món chính, món phụ đến tráng miệng." />
    <meta name="keywords" content="công thức nấu ăn, KemRecipe, món chính, món phụ, tráng miệng" />
    <meta name="author" content="KemRecipe Team" />
    <title>Danh Sách Công Thức - KemRecipe</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        .recipe-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .recipe-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        }

        .recipe-card img {
            transition: transform 0.3s ease;
        }

        .recipe-card:hover img {
            transform: scale(1.03);
        }

        .filter-btn,
        .portion-btn,
        .time-btn,
        .difficulty-btn {
            transition: all 0.3s ease;
            background: linear-gradient(to right, #f3f4f6, #e5e7eb);
        }

        .filter-btn:hover,
        .portion-btn:hover,
        .time-btn:hover,
        .difficulty-btn:hover {
            background: linear-gradient(to right, #f59e0b, #d97706);
            color: white;
        }

        .filter-btn.active,
        .portion-btn.active,
        .time-btn.active,
        .difficulty-btn.active {
            background: linear-gradient(to right, #f59e0b, #d97706);
            color: white;
        }

        .placeholder {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
        }

        @keyframes loading {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        #sidebar {
            transition: transform 0.3s ease;
            background: linear-gradient(to bottom, #ffffff, #f9fafb);
        }

        @media (max-width: 768px) {
            #sidebar {
                transform: translateX(-100%);
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 50;
                box-shadow: 4px 0 12px rgba(0, 0, 0, 0.1);
                padding: 1.5rem;
                overflow-y: auto; /* Thêm thanh cuộn khi nội dung quá dài */
            }

            #sidebar.open {
                transform: translateX(0);
            }

            #mainContent {
                width: 100% !important;
            }
        }

        .category-badge {
            background: linear-gradient(to right, #3b82f6, #2563eb);
        }
    </style>
</head>

<body class="bg-gray-50 font-sans">
    <div class="min-h-screen px-4 py-8">
        <main class="max-w-8xl mx-auto">
            <button id="toggleSidebar"
                class="md:hidden fixed top-3 left-3 z-50 p-2.5 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-full shadow-lg hover:from-amber-600 hover:to-orange-600 transition">
                <i class="fas fa-filter text-base"></i>
            </button>
            <div class="bg-black/40 hidden md:hidden fixed inset-0 z-40" id="overlay"></div>

    <div class="flex flex-col md:flex-row gap-6">
    <aside id="sidebar" class="w-full md:w-[22%] bg-white p-5 rounded-xl shadow-lg h-fit transition-all duration-300">
        <button id="closeSidebar" class="absolute top-3 right-3 text-gray-500 md:hidden hover:text-gray-900 transition">
            <i class="fas fa-times text-xl"></i>
        </button>

        <h3 class="text-2xl font-bold text-gray-800 mb-6">Bộ Lọc Nâng Cao</h3>

        <div class="mb-6">
            <label class="block text-gray-700 font-semibold mb-2 flex items-center text-sm">
                <i class="fas fa-carrot mr-2 text-orange-500"></i> Tìm theo nguyên liệu
            </label>
            <div class="relative">
                <input type="text" id="nguyenLieuInput" placeholder="VD: Gà, Khoai tây, ..."
                       class="w-full p-2.5 pl-10 pr-3 border border-gray-200 rounded-full shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm bg-gray-50 transition"
                       value="<%= filters.nguyenLieu || '' %>" />
                <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm"></i>
            </div>
        </div>

        <div class="mb-6">
            <label class="block text-gray-700 font-semibold mb-2 flex items-center text-sm">
                <i class="fas fa-utensils mr-2 text-orange-500"></i> Số phần ăn
            </label>
            <div class="flex flex-wrap gap-2">
                <button class="portion-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-so-phan="1-2">1-2 người</button>
                <button class="portion-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-so-phan="3-4">3-4 người</button>
                <button class="portion-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-so-phan="5+">5+ người</button>
                <button class="portion-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-so-phan="">Tất cả</button>
            </div>
        </div>

        <div class="mb-6">
            <label class="block text-gray-700 font-semibold mb-2 flex items-center text-sm">
                <i class="fas fa-clock mr-2 text-orange-500"></i> Thời gian nấu
            </label>
            <div class="flex flex-wrap gap-2">
                <button class="time-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-thoi-gian="duoi-30">Dưới 30 phút</button>
                <button class="time-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-thoi-gian="30-60">30-60 phút</button>
                <button class="time-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-thoi-gian="tren-60">Trên 60 phút</button>
                <button class="time-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-thoi-gian="">Tất cả</button>
            </div>
        </div>

        <div class="mb-6">
            <label class="block text-gray-700 font-semibold mb-2 flex items-center text-sm">
                <i class="fas fa-fire mr-2 text-orange-500"></i> Độ khó
            </label>
            <div class="flex flex-wrap gap-2">
                <button class="difficulty-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-do-kho="de">Dễ</button>
                <button class="difficulty-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-do-kho="trung-binh">Trung bình</button>
                <button class="difficulty-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-do-kho="kho">Khó</button>
                <button class="difficulty-btn px-4 py-2 rounded-full text-gray-700 text-xs font-medium bg-gray-100 hover:bg-amber-100 hover:text-amber-700 transition" data-do-kho="">Tất cả</button>
            </div>
        </div>

        <button id="resetFilters"
                class="w-full px-4 py-3 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-full hover:from-red-600 hover:to-red-700 font-semibold shadow-lg transition text-sm">
            Xóa Bộ Lọc
        </button>
    </aside>

    <section id="mainContent" class="w-full md:w-[78%] p-6 rounded-xl shadow-lg">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-6">
            <div class="relative w-full md:w-2/3">
                <input type="text" id="timKiemInput" placeholder="Tìm kiếm tên công thức..."
                       class="w-full p-3.5 pl-11 pr-4 border border-gray-200 rounded-full shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm bg-gray-50 transition"
                       value="<%= filters.timKiem || '' %>" />
                <i class="fas fa-search absolute left-3.5 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm"></i>
            </div>
            <select id="sapXepSelect"
                    class="p-2.5 border border-gray-200 rounded-full shadow-sm focus:outline-none bg-gray-50 text-gray-700 font-medium text-sm transition">
                <option value="mac-dinh" <%= filters.sapXep === 'mac-dinh' ? 'selected' : '' %>>Sắp xếp: Mặc định</option>
                <option value="thoi-gian-tang-dan" <%= filters.sapXep === 'thoi-gian-tang-dan' ? 'selected' : '' %>>Thời gian: Tăng dần</option>
                <option value="thoi-gian-giam-dan" <%= filters.sapXep === 'thoi-gian-giam-dan' ? 'selected' : '' %>>Thời gian: Giảm dần</option>
                <option value="danh-gia-cao-nhat" <%= filters.sapXep === 'danh-gia-cao-nhat' ? 'selected' : '' %>>Đánh giá: Cao nhất</option>
            </select>
        </div>

        <div id="recipeList" class="grid grid-cols-1 gap-5">
            <% if (recipes.length > 0) { %>
                <% recipes.forEach(function(recipe) { %>
                    <%- include('../partials/recipeCard.ejs', { recipe: recipe }) %>
                <% }); %>
            <% } else { %>
                <p id="noResults" class="text-center text-gray-500 text-sm font-medium mt-6 col-span-full">
                    Không tìm thấy công thức nào phù hợp. Hãy thử từ khóa khác!
                </p>
            <% } %>
        </div>

        <div class="flex justify-center mt-8">
            <button id="showMoreBtn"
                    class="px-6 py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-full hover:from-amber-600 hover:to-orange-600 font-semibold shadow-md transition <%= hasMore ? '' : 'hidden' %>">
                Xem Thêm
            </button>
        </div>
    </section>
</div>

<style>
    /* CSS để làm nổi bật nút đã chọn */
    .portion-btn.selected,
    .time-btn.selected,
    .difficulty-btn.selected {
        background-color: #FBBF24; /* amber-400 */
        color: white;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
</style>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleSidebarBtn = document.getElementById('toggleSidebar');
            const closeSidebarBtn = document.getElementById('closeSidebar'); // Thêm nút đóng
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');

            function toggleSidebar() {
                sidebar.classList.toggle('open');
                overlay.classList.toggle('hidden');
            }

            if (toggleSidebarBtn && sidebar && overlay && closeSidebarBtn) {
                toggleSidebarBtn.addEventListener('click', toggleSidebar);
                overlay.addEventListener('click', toggleSidebar);
                closeSidebarBtn.addEventListener('click', toggleSidebar); // Gắn sự kiện cho nút đóng
            }
        });
    </script>
    <script src="/index/cong-thuc.js"></script>
</body>

</html>