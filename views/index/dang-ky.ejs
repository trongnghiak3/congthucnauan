<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng Ký - KemzRecipe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-yellow-50 m-0 p-0">
  <div class="w-screen h-screen flex overflow-hidden">
    <!-- Hình ảnh bên trái -->
    <div class="hidden md:block md:w-1/2 h-full">
      <img 
        src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=1600&q=80" 
        alt="Hình ảnh ẩm thực" 
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Form đăng ký bên phải -->
    <div class="w-full md:w-1/2 h-full flex items-center justify-center bg-white p-6 md:p-14">
      <div class="w-full max-w-xl">
        <h2 class="text-5xl font-extrabold text-yellow-600 text-center mb-4">Tạo Tài Khoản</h2>
        <p class="text-center text-gray-600 mb-10 text-xl">Tham gia KemzRecipe và khám phá hương vị tuyệt vời mỗi ngày! 🧁</p>

        <form action="/register" method="POST" class="space-y-6 text-base">
          <!-- Họ và tên -->
          <div>
            <label for="name" class="block text-gray-800 font-semibold mb-2">👤 Họ và tên</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="Nguyễn Văn A"
              class="w-full p-4 border border-gray-300 rounded-xl focus:outline-none focus:ring-4 focus:ring-yellow-400 transition"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-gray-800 font-semibold mb-2">📧 Email</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="you@example.com"
              class="w-full p-4 border border-gray-300 rounded-xl focus:outline-none focus:ring-4 focus:ring-yellow-400 transition"
            />
          </div>

          <!-- Mật khẩu -->
          <div>
            <label for="password" class="block text-gray-800 font-semibold mb-2">🔒 Mật khẩu</label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              required 
              placeholder="Ít nhất 8 ký tự"
              class="w-full p-4 border border-gray-300 rounded-xl focus:outline-none focus:ring-4 focus:ring-yellow-400 transition"
            />
          </div>

          <!-- Xác nhận mật khẩu -->
          <div>
            <label for="confirmPassword" class="block text-gray-800 font-semibold mb-2">✅ Xác nhận mật khẩu</label>
            <input 
              type="password" 
              id="confirmPassword" 
              name="confirmPassword" 
              required 
              placeholder="Nhập lại mật khẩu"
              class="w-full p-4 border border-gray-300 rounded-xl focus:outline-none focus:ring-4 focus:ring-yellow-400 transition"
            />
          </div>

          <!-- Nút đăng ký -->
          <div>
            <button 
              type="submit" 
              class="w-full bg-yellow-500 hover:bg-yellow-600 text-white py-4 rounded-xl font-semibold text-lg transition duration-200 shadow-md"
            >
              🎉 Đăng Ký
            </button>
          </div>

          <!-- Chuyển đến đăng nhập -->
          <div class="text-center">
            <p class="text-base text-gray-600">Đã có tài khoản?
              <a href="/login" class="text-yellow-600 hover:underline font-semibold">Đăng nhập ngay</a>
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
