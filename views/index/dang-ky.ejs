<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng Ký - KemzRecipe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-yellow-50 m-0 p-0">
  <div id="admin-notification" class="hidden"></div>
  <div class="w-screen h-screen flex overflow-hidden">
    <div class="hidden md:block md:w-1/2 h-full">
      <img
        src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=1600&q=80"
        alt="Hình ảnh ẩm thực"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="w-full md:w-1/2 h-full flex items-center justify-center bg-white p-4 md:p-10">
      <div class="w-full max-w-lg">
        <h2 class="text-4xl font-extrabold text-yellow-600 text-center mb-3">Tạo Tài Khoản</h2>
        <p class="text-center text-gray-600 mb-8 text-lg">Tham gia KemzRecipe và khám phá hương vị tuyệt vời mỗi ngày! 🧁</p>

        <form action="/dang-ky" method="POST" class="space-y-5 text-base">
          <div>
            <label for="name" class="block text-gray-800 font-semibold mb-1.5">👤 Họ và tên</label>
            <input type="text" id="name" name="name" required placeholder="Nguyễn Văn A"
              class="w-full p-3.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-3 focus:ring-yellow-400 transition text-sm" />
          </div>

          <div>
            <label for="email" class="block text-gray-800 font-semibold mb-1.5">📧 Email</label>
            <input type="email" id="email" name="email" required placeholder="nguyenvana@email.com"
              class="w-full p-3.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-3 focus:ring-yellow-400 transition text-sm" />
          </div>

          <div>
            <label for="password" class="block text-gray-800 font-semibold mb-1.5">🔒 Mật khẩu</label>
            <div class="relative">
              <input type="password" id="password" name="password" required placeholder="Ít nhất 8 ký tự"
                class="w-full p-3.5 pr-10 border border-gray-300 rounded-lg focus:outline-none focus:ring-3 focus:ring-yellow-400 transition text-sm" />
              <button type="button" id="togglePassword" class="absolute right-3 top-3.5 text-xl text-gray-500">👁️</button>
            </div>
          </div>

          <div>
            <label for="confirmPassword" class="block text-gray-800 font-semibold mb-1.5">✅ Xác nhận mật khẩu</label>
            <div class="relative">
              <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="Nhập lại mật khẩu"
                class="w-full p-3.5 pr-10 border border-gray-300 rounded-lg focus:outline-none focus:ring-3 focus:ring-yellow-400 transition text-sm" />
              <button type="button" id="toggleConfirmPassword" class="absolute right-3 top-3.5 text-xl text-gray-500">👁️</button>
            </div>
          </div>

          <div>
            <button type="submit"
              class="w-full bg-yellow-500 hover:bg-yellow-600 text-white py-3 rounded-lg font-semibold text-base transition duration-200 shadow-md">
              🎉 Đăng Ký
            </button>
          </div>

          <div class="text-center mt-3">
            <p class="text-sm text-gray-600">Đã có tài khoản?
              <a href="/dang-nhap" class="text-yellow-600 hover:underline font-semibold">Đăng nhập ngay</a>
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function togglePasswordVisibility(inputId, buttonId) {
      const input = document.getElementById(inputId);
      const button = document.getElementById(buttonId);
      button.addEventListener('click', () => {
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        button.textContent = isPassword ? '🙈' : '👁️';
      });
    }

    togglePasswordVisibility('password', 'togglePassword');
    togglePasswordVisibility('confirmPassword', 'toggleConfirmPassword');
     function showAdminNotification(message, type = 'success') {
    const notif = document.getElementById('admin-notification');
    notif.innerHTML = '';

    const icons = {
      success: '✅',
      error: '❌',
      info: 'ℹ️',
      warning: '⚠️'
    };
    const bgColors = {
      success: 'bg-green-500',
      error: 'bg-red-500',
      info: 'bg-blue-500',
      warning: 'bg-yellow-500'
    };

    notif.className = `fixed top-5 right-5 z-50 flex items-start gap-3 px-4 py-3 rounded-xl text-white shadow-xl transform transition-all duration-300 ease-in-out opacity-0 ${bgColors[type] || bgColors.success}`;
    notif.innerHTML = `
      <div class="text-2xl">${icons[type] || icons.success}</div>
      <div class="text-sm font-medium">${message}</div>
    `;

    notif.classList.remove('hidden');
    setTimeout(() => {
      notif.classList.add('opacity-100', 'translate-y-0');
    }, 10);

    setTimeout(() => {
      notif.classList.remove('opacity-100');
      notif.classList.add('opacity-0');
    }, 3000);

    setTimeout(() => {
      notif.classList.add('hidden');
    }, 3500);
  }
</script>

<% if (typeof notify !== 'undefined') { %>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      showAdminNotification("<%= notify.message %>", "<%= notify.type %>");
    });
  </script>
<% } %>
  </script>
</body>
</html>
