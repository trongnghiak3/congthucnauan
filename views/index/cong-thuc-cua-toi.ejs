<div class="bg-white rounded-3xl shadow-lg p-6 md:p-8 lg:p-10 mt-8 transform transition-all duration-300 hover:shadow-xl border border-gray-100">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8 pb-4 border-b border-gray-200">
    <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-800 flex items-center gap-3 animate-fade-in mb-4 sm:mb-0">
      <i class="fas fa-utensils text-yellow-600 text-3xl"></i> Công Thức Của Bạn
    </h2>
    <span class="inline-flex items-center px-5 py-2 rounded-full font-semibold text-sm bg-yellow-50 text-yellow-700 shadow-sm">
      <i class="fas fa-list-ul mr-2 text-yellow-600"></i> <%= userRecipes ? userRecipes.length : 0 %> công thức
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 lg:gap-8">

    <% if (userRecipes && userRecipes.length > 0) { %>
      <% userRecipes.forEach(function(recipe) { %>
        <div class="relative group animate-slide-up bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden">
          <%- include('../partials/recipeCardHorizontal.ejs', { recipe: recipe }) %>
          
       <div class="absolute inset-0 bg-black bg-opacity-60 rounded-xl flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-4 space-y-3">
  <% if (recipe.TRANG_THAI_DUYET_ === 'Đang chờ duyệt' || recipe.TRANG_THAI_DUYET_ === 'Từ chối') { %>
    <a href="/dang-cong-thuc/<%= recipe.ID_CHINH_CT %>" class="w-full max-w-[150px] text-center bg-yellow-500 text-white px-5 py-2 rounded-lg font-semibold hover:bg-yellow-600 transition transform hover:scale-105 flex items-center justify-center gap-2 text-sm md:text-base">
      <i class="fas fa-edit"></i> Sửa
    </a>
    <button onclick="deleteRecipe('<%= recipe.ID_CHINH_CT %>')" class="w-full max-w-[150px] text-center bg-red-500 text-white px-5 py-2 rounded-lg font-semibold hover:bg-red-600 transition transform hover:scale-105 flex items-center justify-center gap-2 text-sm md:text-base">
      <i class="fas fa-trash"></i> Xóa
    </button>
  <% } else if (recipe.TRANG_THAI_DUYET_ === 'Đã duyệt') { %>
    <a href="/cong-thuc/<%= recipe.ID_CHINH_CT %>" class="w-full max-w-[180px] text-center bg-blue-500 text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-600 transition transform hover:scale-105 flex items-center justify-center gap-2 text-sm md:text-base">
      <i class="fas fa-eye"></i> Xem công thức
    </a>
  <% } %>
</div>

          <span class="absolute top-3 right-3 z-10 inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold shadow-sm
            <%= recipe.TRANG_THAI_DUYET_ === 'Đã duyệt' ? 'bg-green-100 text-green-700' : 
                recipe.TRANG_THAI_DUYET_ === 'Đang chờ duyệt' ? 'bg-yellow-100 text-yellow-700' : 
                'bg-red-100 text-red-700' %>">
            <%= recipe.TRANG_THAI_DUYET_ %>
          </span>
        </div>
      <% }); %>
    <% } else { %>
      <div class="text-center col-span-full py-16 px-4 animate-fade-in bg-gray-50 rounded-xl shadow-inner">
        <i class="fas fa-utensils text-gray-300 text-7xl mb-6 animate-pulse"></i>
        <p class="text-gray-700 text-xl md:text-2xl font-semibold mb-6">Bạn chưa có công thức nào cả!</p>
        <a href="/dang-cong-thuc" class="inline-flex items-center bg-yellow-500 text-white px-8 py-4 rounded-full hover:bg-yellow-600 transition transform hover:scale-105 font-bold text-lg shadow-lg" onclick="document.getElementById('openAddRecipeForm').click()">
          <i class="fas fa-plus mr-3 text-xl"></i> Đăng công thức ngay
        </a>
      </div>
    <% } %>
  </div>
</div>

    <script src="/index/dangcongthuc.js"></script>