<div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
  <!-- Tiêu đề -->
  <div class="mb-10 text-center">
    <h1 class="text-4xl md:text-5xl font-extrabold text-amber-700 mb-3 leading-tight">
      Khám phá các Danh mục món ăn
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
      Bạn muốn nấu món gì hôm nay? Duyệt qua hàng trăm công thức ngon miệng theo từng danh mục.
    </p>
  </div>

  <!-- Form tìm kiếm -->
  <form action="/danh-muc" method="GET" class="mb-10 text-center">
    <input type="text" name="search" placeholder="Tìm danh mục..."
           value="<%= search %>"
           class="w-full max-w-md px-4 py-2 border rounded-full shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-500" />
  </form>

  <!-- Danh sách danh mục -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8 xl:gap-10">
    <% categories.forEach(cat => { %>
      <a href="/danh-muc/<%= cat.SLUG_LM %>"
         class="group block bg-white rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02] relative cursor-pointer">
        <% if (cat.HINH_ANH_LM_URL) { %>
          <div class="h-44 md:h-52 overflow-hidden">
            <img src="<%= cat.HINH_ANH_LM_URL %>" alt="<%= cat.TEN_LM %>"
                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
          </div>
        <% } else { %>
          <div class="w-full h-44 md:h-52 bg-gray-100 flex items-center justify-center text-gray-400 animate-pulse">
            <i class="fas fa-utensils text-4xl mr-2"></i> Không có ảnh
          </div>
        <% } %>

        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black via-black/80 to-transparent p-4 pb-6 text-center">
          <h3 class="text-lg md:text-xl font-bold text-white group-hover:text-amber-300 transition duration-300 drop-shadow leading-tight">
            <%= cat.TEN_LM %>
          </h3>

          <% if (cat.MOTA_NGAN_LM) { %>
            <p class="text-sm text-gray-300 mt-1 opacity-90 group-hover:opacity-100 transition-opacity duration-300 line-clamp-2">
              <%= cat.MOTA_NGAN_LM %>
            </p>
          <% } else if (cat.SO_LUONG_MON_AN) { %>
            <p class="text-sm text-gray-300 mt-1">Khám phá <strong><%= cat.SO_LUONG_MON_AN %></strong> món ăn</p>
          <% } else { %>
            <p class="text-sm text-gray-300 mt-1">Khám phá ngay!</p>
          <% } %>

          <div class="mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <span class="inline-flex items-center px-3 py-1 bg-amber-600 text-white text-xs font-semibold rounded-full shadow">
              Xem danh mục <i class="fas fa-arrow-right ml-1 text-xs"></i>
            </span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>

  <!-- Phân trang -->
<% if (totalPages > 1) { %>
    <div class="flex justify-center mt-12 space-x-2">
        <!-- Nút trang trước -->
        <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>"
               class="px-4 py-2 bg-yellow-500 rounded-full text-white font-semibold hover:bg-yellow-600 text-base shadow-md transition-all duration-200 flex items-center justify-center">
                <i class="fas fa-chevron-left"></i>
            </a>
        <% } %>

        <!-- Hiển thị số trang -->
        <%
            const maxPageButtons = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxPageButtons / 2));
            let endPage = Math.min(totalPages, startPage + maxPageButtons - 1);

            if (endPage - startPage < maxPageButtons - 1) {
                startPage = Math.max(1, totalPages - maxPageButtons + 1);
            }

            if (startPage > 1) { %>
                <a href="?page=1&search=<%= search || '' %>"
                   class="px-4 py-2 rounded-full text-base font-semibold transition-all duration-200 bg-white border border-yellow-500 text-gray-700 hover:bg-yellow-100 hover:border-yellow-600">
                    1
                </a>
                <% if (startPage > 2) { %>
                    <span class="px-2 py-1.5 text-gray-500 text-lg">...</span>
                <% } %>
        <% } %>

        <!-- Các nút trang -->
        <% for (let i = startPage; i <= endPage; i++) { %>
            <a href="?page=<%= i %>&search=<%= search || '' %>"
               class="px-4 py-2 rounded-full text-base font-semibold transition-all duration-200 <%= i === currentPage ? 'bg-yellow-500 text-white shadow-md' : 'bg-white border border-yellow-500 text-gray-700 hover:bg-yellow-100 hover:border-yellow-600' %>">
                <%= i %>
            </a>
        <% } %>

        <!-- Hiển thị trang cuối và dấu chấm lửng -->
        <% if (endPage < totalPages) { %>
            <% if (endPage < totalPages - 1) { %>
                <span class="px-2 py-1.5 text-gray-500 text-lg">...</span>
            <% } %>
            <a href="?page=<%= totalPages %>&search=<%= search || '' %>"
               class="px-4 py-2 rounded-full text-base font-semibold transition-all duration-200 bg-white border border-yellow-500 text-gray-700 hover:bg-yellow-100 hover:border-yellow-600">
                <%= totalPages %>
            </a>
        <% } %>

        <!-- Nút trang sau -->
        <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>"
               class="px-4 py-2 bg-yellow-500 rounded-full text-white font-semibold hover:bg-yellow-600 text-base shadow-md transition-all duration-200 flex items-center justify-center">
                <i class="fas fa-chevron-right"></i>
            </a>
        <% } %>
    </div>
<% } %>
</div>

<style>
  .group:hover .group-hover\:scale-110 {
    transform: scale(1.1);
  }
  .group:hover .shadow-xl {
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
  }
</style>
