<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>KemRecipe</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat+Alternates:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css" rel="stylesheet">
</head>
  <style>
    body { font-family: 'Montserrat Alternates', sans-serif; }
  </style>
</head>

<body class="bg-gray-50 text-sm flex flex-col min-h-screen">
  <div id="admin-notification" class="hidden"></div>
  <!-- Navbar -->
  <nav class="bg-white shadow py-2 md:py-3">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
      <!-- Logo -->
      <a href="/" class="text-lg md:text-2xl font-bold text-gray-700 hover:text-yellow-500 flex items-center gap-2">
        <i class="fa-solid fa-ice-cream text-yellow-500"></i> KemRecipe
      </a>

      <!-- Menu Desktop -->
      <ul class="hidden md:flex items-center space-x-4 lg:space-x-6 text-gray-600 font-medium">
        <li><a href="/" class="hover:text-yellow-500"><i class="fa-solid fa-house mr-1"></i>Trang chủ</a></li>
        <li><a href="/mon-an" class="hover:text-yellow-500"><i class="fa-solid fa-mug-hot mr-1"></i>Khám phá Món ăn</a></li>
        <li><a href="/cong-thuc" class="hover:text-yellow-500"><i class="fa-solid fa-utensils mr-1"></i>Công thức</a></li>
        <li><a href="/danh-muc" class="hover:text-yellow-500"><i class="fa-solid fa-folder-open mr-1"></i>Danh mục</a></li>
        <li><a href="/gioi-thieu" class="hover:text-yellow-500"><i class="fa-solid fa-circle-info mr-1"></i>Giới thiệu</a></li>
        <li><a href="/lien-he" class="hover:text-yellow-500"><i class="fa-solid fa-envelope mr-1"></i>Liên hệ</a></li>
      </ul>

      <!-- Tài khoản -->
      <div class="flex items-center space-x-3">
        <% if (typeof user !== 'undefined' && user) { %>
          <!-- Avatar + Dropdown -->
        <div class="relative hidden md:flex items-center space-x-2 cursor-pointer" id="user-avatar">
  <img src="<%= user.avatar || '/default-avatar.png' %>" class="w-8 h-8 rounded-full border object-cover" alt="Avatar" />
  <span class="truncate max-w-[100px] text-gray-700 font-medium"><%= user.TEN_NGUOI_DUNG %></span>

  <!-- Dropdown sửa lại vị trí -->
  <div id="user-dropdown"
       class="absolute right-0 top-full mt-2 w-44 bg-white shadow rounded-md text-sm hidden z-50">
    <a href="/profile" class="block px-4 py-2 hover:text-yellow-500"><i class="fa-solid fa-user mr-2"></i>Thông tin cá nhân</a>
    <a href="/cong-thuc-cua-toi" class="block px-4 py-2 hover:text-yellow-500"><i class="fa-solid fa-receipt mr-2"></i>Công thức của tôi</a>
    <a href="/logout" class="block px-4 py-2 hover:text-yellow-500"><i class="fa-solid fa-right-from-bracket mr-2"></i>Đăng xuất</a>
  </div>
</div>

          <!-- Nút đăng công thức -->
          <a href="/dang-cong-thuc" class="hidden md:block bg-yellow-500 text-white text-sm px-3 py-1.5 rounded-full font-semibold hover:bg-yellow-600 transition">
            <i class="fa-solid fa-plus mr-1"></i>Đăng món
          </a>
        <% } else { %>
          <a href="/login" class="hidden md:flex bg-yellow-500 text-white text-sm px-4 py-1.5 rounded-md hover:bg-yellow-600 transition">
            <i class="fa-solid fa-right-to-bracket mr-2"></i>Đăng nhập
          </a>
        <% } %>

        <!-- Mobile toggle -->
        <button id="menu-toggle" class="md:hidden text-xl text-gray-700">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <ul id="mobile-menu" class="md:hidden hidden flex-col space-y-2 py-3 px-4 bg-white shadow mt-2 text-gray-600 text-sm font-medium">
      <li><a href="/" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-house mr-1"></i>Trang chủ</a></li>
      <li><a href="/mon-an" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-mug-hot mr-1"></i>Món ăn</a></li>
      <li><a href="/cong-thuc" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-utensils mr-1"></i>Công thức</a></li>
      <li><a href="/danh-muc" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-folder-open mr-1"></i>Danh mục</a></li>
      <li><a href="/gioi-thieu" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-circle-info mr-1"></i>Giới thiệu</a></li>
      <li><a href="/lien-he" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-envelope mr-1"></i>Liên hệ</a></li>

      <% if (typeof user !== 'undefined' && user) { %>
        <li><a href="/profile" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-user mr-1"></i>Thông tin cá nhân</a></li>
        <li><a href="/cong-thuc-cua-toi" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-receipt mr-1"></i>Công thức của tôi</a></li>
        <li><a href="/dang-cong-thuc" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-plus mr-1"></i>Đăng công thức</a></li>
        <li><a href="/logout" class="block py-1 hover:text-yellow-500"><i class="fa-solid fa-right-from-bracket mr-1"></i>Đăng xuất</a></li>
      <% } else { %>
        <li><a href="/login" class="block py-1 text-white bg-yellow-500 rounded-md hover:bg-yellow-600"><i class="fa-solid fa-right-to-bracket mr-1"></i>Đăng nhập</a></li>
      <% } %>
    </ul>
  </nav>

  <!-- Nội dung -->
<div class="flex-grow">
    <main class="px-3 md:px-4 mt-4">
      <%- include(viewPath) %>
    </main>
  </div>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- JS -->
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
<script src="/index/index.js"></script>
 <script src="/index/cong-thuc.js"></script>
 <script src="/index/chitietcongthuc.js"></script>
 <script src="/index/profile.js"></script>
 <script src="/index/dangcongthuc.js"></script>
</body>
</html>
