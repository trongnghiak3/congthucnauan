<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Liên Hệ - Công Thức Nấu Ăn</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
  <style>
    body { font-family: 'Quicksand', sans-serif; }
  </style>
</head>
<body class="bg-yellow-50 font-sans text-sm leading-normal tracking-normal ">

  <div class="max-w-lg mx-auto mt-10 p-6 bg-white rounded-2xl shadow-xl border border-yellow-100">
    <h1 class="text-2xl font-bold text-yellow-600 mb-2 flex items-center gap-2">
      <i class="fas fa-envelope-open-text text-yellow-500"></i> Liên hệ với chúng tôi
    </h1>
    <p class="text-gray-600 mb-6">Bạn có góp ý hay công thức muốn chia sẻ? Hãy để lại lời nhắn cho chúng tôi nhé!</p>

    <% if (success) { %>
      <div class="bg-green-100 border border-green-300 text-green-700 p-3 rounded mb-4 text-sm">
        <i class="fas fa-check-circle mr-2"></i><%= success %>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="bg-red-100 border border-red-300 text-red-700 p-3 rounded mb-4 text-sm">
        <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
      </div>
    <% } %>

    <form action="/lien-he" method="POST" class="space-y-5">
      <div>
        <label class="block text-gray-700 font-medium mb-1">👤 Họ tên</label>
        <input type="text" name="hoTen" required placeholder="Nhập họ tên của bạn"
               class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-400"/>
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-1">📧 Email</label>
        <input type="email" name="email" required placeholder="example@email.com"
               class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-400"/>
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-1">📌 Chủ đề</label>
        <input type="text" name="chuDe" required placeholder="Chủ đề bạn muốn gửi"
               class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-400"/>
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-1">📝 Nội dung</label>
        <textarea name="noiDung" rows="4" required placeholder="Nhập nội dung chi tiết..."
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-400"></textarea>
      </div>

      <button type="submit"
              class="w-full bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-2 rounded-md transition duration-200 shadow-md">
        <i class="fas fa-paper-plane mr-2"></i> Gửi liên hệ
      </button>
    </form>
  </div>

</body>
</html>
