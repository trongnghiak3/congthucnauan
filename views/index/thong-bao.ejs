<div class="bg-white rounded-lg shadow-lg p-6">
  <h2 class="text-2xl font-bold text-gray-800 mb-6">Danh Sách Thông Báo</h2>

  <!-- Thanh tìm kiếm và bộ lọc -->
  <div class="flex justify-between items-center mb-6">
    <div class="relative w-1/3">
      <input type="text" id="search-thong-bao" placeholder="Tìm kiếm thông báo..." 
             class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-yellow-500"
             value="<%= search || '' %>">
      <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
    </div>
    <div>
      <select id="filter-thong-bao" class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-yellow-500">
        <option value="all" <%= filter === 'all' ? 'selected' : '' %>>Tất cả</option>
        <option value="unread" <%= filter === 'unread' ? 'selected' : '' %>>Chưa đọc</option>
        <option value="read" <%= filter === 'read' ? 'selected' : '' %>>Đã đọc</option>
      </select>
    </div>
  </div>

  <!-- Danh sách thông báo -->
  <div id="thong-bao-list" class="space-y-4">
    <% if (thong_bao && thong_bao.length > 0) { %>
      <% thong_bao.forEach(tb => { 
        let bgColor = 'bg-gray-50';
        let borderColor = 'border-gray-300';
        let iconClass = 'fas fa-bell';
        let iconColor = 'text-yellow-500';
        let statusColor = ''; // Màu cho trạng thái

        // Xác định màu sắc và icon dựa trên LOAI_TB
        if (tb.LOAI_TB === 'cong_thuc') {
          bgColor = 'bg-blue-50'; borderColor = 'border-blue-400'; iconClass = 'fas fa-utensils'; iconColor = 'text-blue-500';
        } else if (tb.LOAI_TB === 'binh_luan') {
          bgColor = 'bg-green-50'; borderColor = 'border-green-400'; iconClass = 'fas fa-comments'; iconColor = 'text-green-500';
        } else if (tb.LOAI_TB === 'phan_hoi_binh_luan') {
          bgColor = 'bg-purple-50'; borderColor = 'border-purple-400'; iconClass = 'fas fa-reply'; iconColor = 'text-purple-500';
        } else if (tb.LOAI_TB === 'danh_gia') {
          bgColor = 'bg-yellow-50'; borderColor = 'border-yellow-400'; iconClass = 'fas fa-star'; iconColor = 'text-yellow-500';
        } else if (tb.LOAI_TB === 'yeu_thich') {
          bgColor = 'bg-red-50'; borderColor = 'border-red-400'; iconClass = 'fas fa-heart'; iconColor = 'text-red-500';
        } else if (tb.LOAI_TB === 'binh_luan_cam_xuc' || tb.LOAI_TB === 'phan_hoi_cam_xuc') {
          bgColor = 'bg-pink-50'; borderColor = 'border-pink-400'; iconClass = 'fas fa-smile'; iconColor = 'text-pink-500';
        }

        // Ưu tiên màu sắc và icon dựa trên TRANG_THAI_DUYET_
        if (tb.TRANG_THAI_DUYET_ === 'Đã duyệt') {
          bgColor = 'bg-green-50'; borderColor = 'border-green-400'; iconClass = 'fas fa-check-circle'; iconColor = 'text-green-500'; statusColor = 'text-green-700';
        } else if (tb.TRANG_THAI_DUYET_ === 'Từ chối') {
          bgColor = 'bg-red-50'; borderColor = 'border-red-400'; iconClass = 'fas fa-times-circle'; iconColor = 'text-red-500'; statusColor = 'text-red-700';
        }
      %>
   <div class="thong-bao-item flex items-start gap-3 p-4 border-l-4 shadow-md rounded-xl <%= bgColor %> <%= borderColor %> <%= tb.DA_DOC ? 'opacity-60' : '' %>"
     data-id="<%= tb.ID_CHINH_TB %>" data-type="<%= tb.LOAI_TB %>">
  <i class="<%= iconClass %> <%= iconColor %> text-lg mt-1"></i>
  <div class="flex-1">
    <p class="text-gray-800 text-base font-semibold"><%= tb.NOI_DUNG_TB %></p>
    <% if (tb.TRANG_THAI_DUYET_) { %>
      <p class="text-sm font-medium <%= statusColor %>">
        <%= tb.TRANG_THAI_DUYET_ %> <%= tb.TRANG_THAI_DUYET_ === 'Đã duyệt' ? '✓' : tb.TRANG_THAI_DUYET_ === 'Từ chối' ? '✗' : '' %>
      </p>
    <% } %>
   <%
  const emotionIcons = {
    like: '👍',
    love: '❤️',
    haha: '😂',
    wow: '😮',
    sad: '😢',
    angry: '😣'
  };

  let emotionIcon = '';
  if ((tb.LOAI_TB === 'binh_luan_cam_xuc' || tb.LOAI_TB === 'phan_hoi_cam_xuc')) {
    const match = tb.NOI_DUNG_TB.match(/cảm xúc[:\s]*([a-zA-Z]+)/i);
    if (match && match[1]) {
      const emo = match[1].toLowerCase();
      emotionIcon = emotionIcons[emo] || '';
    }
  }
%>

<% if (emotionIcon) { %>
  <p class="text-gray-600 text-sm italic">Cảm xúc: <%= emotionIcon %></p>
<% } %>

    <p class="text-gray-500 text-sm italic"><%= new Date(tb.NGAY_TAO_TB).toLocaleString('vi-VN') %></p>
    <div class="mt-2 flex gap-4">
      <% if (typeof tb.ID_CHINH_TB !== 'undefined') { %>
        <button class="mark-read-btn text-blue-600 font-medium text-sm underline">Đã đọc</button>
        <button class="delete-btn text-red-600 font-medium text-sm underline">Xóa</button>
      <% } %>
    </div>
  </div>
</div>
      <% }); %>
    <% } else { %>
      <p class="text-gray-500 text-center">Không có thông báo nào.</p>
    <% } %>
  </div>

  <!-- Phân trang -->
  <div class="mt-6 flex justify-center">
    <nav class="flex items-center gap-2">
      <a href="/admin/thong-bao?page=<%= currentPage > 1 ? currentPage - 1 : 1 %><%= filter ? '&filter=' + filter : '' %><%= search ? '&search=' + search : '' %>" 
         class="px-4 py-2 bg-yellow-500 text-white rounded-lg <%= currentPage === 1 ? 'opacity-50 cursor-not-allowed' : '' %>"
         <%= currentPage === 1 ? 'disabled' : '' %>>Trước</a>
      <span class="px-4 py-2 text-gray-700">Trang <%= currentPage %> / <%= totalPages %></span>
      <a href="/admin/thong-bao?page=<%= currentPage < totalPages ? currentPage + 1 : totalPages %><%= filter ? '&filter=' + filter : '' %><%= search ? '&search=' + search : '' %>" 
         class="px-4 py-2 bg-yellow-500 text-white rounded-lg <%= currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : '' %>"
         <%= currentPage === totalPages ? 'disabled' : '' %>>Sau</a>
    </nav>
  </div>
</div>

<!-- Pop-up thông báo -->
<div id="admin-thong-bao" class="hidden"></div>