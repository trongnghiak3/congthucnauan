<div class="bg-white rounded-lg shadow-lg p-6">
  <h2 class="text-2xl font-bold text-gray-800 mb-6">Thông Báo Của Tôi</h2>

  <div class="flex justify-between items-center mb-6">
    <div class="relative w-1/3">
      <input type="text" id="search-thong-bao" placeholder="Tìm kiếm thông báo..." 
             class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-yellow-500"
             value="<%= search || '' %>">
      <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
    </div>
    <div>
      <select id="filter-thong-bao" class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-yellow-500">
        <option value="all" <%= filter === 'all' ? 'selected' : '' %>>Tất cả</option>
        <option value="unread" <%= filter === 'unread' ? 'selected' : '' %>>Chưa đọc</option>
        <option value="read" <%= filter === 'read' ? 'selected' : '' %>>Đã đọc</option>
      </select>
    </div>
  </div>

  <div id="thong-bao-list" class="space-y-4">
    <% if (thong_bao && thong_bao.length > 0) { %>
      <% thong_bao.forEach(tb => { 
         let bgColor = 'bg-gray-50';
         let borderColor = 'border-gray-300';  
         let iconClass = 'fas fa-bell text-yellow-500';

         switch (tb.LOAI_TB) {
           case 'cong_thuc':
             bgColor = 'bg-blue-50'; 
             borderColor = 'border-blue-400';
             iconClass = 'fas fa-plus-circle text-blue-600';
             break;
           case 'binh_luan':
             bgColor = 'bg-green-50'; 
             borderColor = 'border-green-400';
             iconClass = 'fas fa-comment-dots text-green-600';
             break;
           case 'phan_hoi':
             bgColor = 'bg-purple-50'; 
             borderColor = 'border-purple-400';
             iconClass = 'fas fa-reply text-purple-600';
             break;
           case 'danh_gia':
             bgColor = 'bg-yellow-50'; 
             borderColor = 'border-yellow-400';
             iconClass = 'fas fa-star text-yellow-600';
             break;
           case 'yeu_thich':
             bgColor = 'bg-red-50'; 
             borderColor = 'border-red-400';
             iconClass = 'fas fa-heart text-red-600';
             break;
           case 'binh_luan_cam_xuc':
           case 'phan_hoi_cam_xuc':
             bgColor = 'bg-pink-50'; 
             borderColor = 'border-pink-400';
             iconClass = 'fas fa-grin-hearts text-pink-600';
             break;
           default:
             bgColor = 'bg-gray-50'; 
             borderColor = 'border-gray-300';
             iconClass = 'fas fa-info-circle text-gray-500';
             break;
         }
      %>
        <div class="thong-bao-item flex items-start gap-3 p-4 border-l-4 shadow-md rounded-xl <%= bgColor %> <%= borderColor %> <%= tb.DA_DOC ? 'opacity-60' : '' %>"
             data-id="<%= tb.ID_CHINH_TB %>">
          <i class="<%= iconClass %> text-lg mt-1"></i>
          <div class="flex-1">
            <p class="text-gray-800 text-base font-semibold"><%= tb.NOI_DUNG_TB %></p>

            <% if ((tb.LOAI_TB === 'binh_luan_cam_xuc' || tb.LOAI_TB === 'phan_hoi_cam_xuc') && tb.NOI_DUNG_TB.includes('cảm xúc')) {
              const emotionMatch = tb.NOI_DUNG_TB.match(/cảm xúc (like|love|haha|wow|sad|angry)/);
              const emotion = emotionMatch ? emotionMatch[1] : null;
              const emotionIcons = { like: '👍', love: '❤️', haha: '😂', wow: '😮', sad: '😢', angry: '😣' };
              const icon = emotion ? emotionIcons[emotion] || '' : '';
            %>
              <p class="text-gray-600 text-sm italic">Cảm xúc: <%= icon %></p>
            <% } %>

            <p class="text-gray-500 text-sm italic"><%= new Date(tb.NGAY_TAO_TB).toLocaleString('vi-VN') %></p>

            <div class="mt-2 flex gap-4">
              <% if (!tb.DA_DOC) { %>
                <button class="mark-read-btn text-blue-600 font-medium text-sm underline">Đánh dấu đã đọc</button>
              <% } %>
              <button class="delete-btn text-red-600 font-medium text-sm underline">Xóa</button>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-gray-500 text-center">Không có thông báo nào.</p>
    <% } %>
  </div>

  <div class="mt-6 flex justify-center">
    <nav class="flex items-center gap-2">
      <a href="<%= urlPrefix %>/thong-bao?page=<%= currentPage > 1 ? currentPage - 1 : 1 %><%= filter ? '&filter=' + filter : '' %><%= search ? '&search=' + search : '' %>" 
         class="px-4 py-2 bg-yellow-500 text-white rounded-lg <%= currentPage === 1 ? 'opacity-50 cursor-not-allowed' : '' %>"
         <%= currentPage === 1 ? 'onclick="return false;"' : '' %>>Trước</a>
      <span class="px-4 py-2 text-gray-700">Trang <%= currentPage %> / <%= totalPages %></span>
      <a href="<%= urlPrefix %>/thong-bao?page=<%= currentPage < totalPages ? currentPage + 1 : totalPages %><%= filter ? '&filter=' + filter : '' %><%= search ? '&search=' + search : '' %>" 
         class="px-4 py-2 bg-yellow-500 text-white rounded-lg <%= currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : '' %>"
         <%= currentPage === totalPages ? 'onclick="return false;"' : '' %>>Sau</a>
    </nav>
  </div>
</div>