<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Danh Sách Món Ăn - KemRecipe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css" />
  <style>
    /* Thêm font-sans để đồng bộ font chữ nếu bạn muốn */
    body {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
    }
  </style>
</head>
<body class="bg-gray-100 font-sans text-gray-800">
  
  <div class="max-w-8xl mx-auto px-4 py-8"> <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4"> <div class="relative w-full sm:w-64"> <input type="text"
               placeholder="Tìm món ăn..."
               class="w-full pl-9 pr-3 py-2 rounded-full border border-gray-300 focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm"> <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm"></i> </div>
      <select class="px-3 py-2 rounded-full border border-gray-300 focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm"> <option>Sắp xếp: Mới nhất</option>
        <option>Phổ biến nhất</option>
        <option>Đánh giá cao</option>
      </select>
    </div>

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
  <% monAnList.forEach(mon => { %>
    <%- include("../partials/mon-an-card", { mon: mon }) %>
  <% }) %>
</div>


    <div class="flex justify-center mt-8 space-x-1.5"> <% if (pagination.currentPage > 1) { %>
        <a href="?page=<%= pagination.currentPage - 1 %>&search=<%= filters.search %>&category=<%= filters.category %>"
           class="px-3 py-1.5 bg-amber-500 rounded-full text-white font-semibold hover:bg-amber-600 text-sm"> <i class="fas fa-chevron-left"></i>
        </a>
      <% } %>

      <% for (let i = 1; i <= pagination.totalPages; i++) { %>
        <a href="?page=<%= i %>&search=<%= filters.search %>&category=<%= filters.category %>"
           class="px-3 py-1.5 rounded-full text-sm
                  <%= i === pagination.currentPage ? 'bg-amber-500 text-white font-semibold' : 'hover:bg-gray-300' %>"> <%= i %>
        </a>
      <% } %>

      <% if (pagination.currentPage < pagination.totalPages) { %>
        <a href="?page=<%= pagination.currentPage + 1 %>&search=<%= filters.search %>&category=<%= filters.category %>"
           class="px-3 py-1.5 bg-amber-500 rounded-full text-white font-semibold hover:bg-amber-600 text-sm"> <i class="fas fa-chevron-right"></i>
        </a>
      <% } %>
    </div>

  </div>

</body>
</html>