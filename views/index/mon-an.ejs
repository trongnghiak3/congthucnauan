<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Danh Sách Món Ăn - KemRecipe</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
        }
        /* Tùy chỉnh thanh cuộn */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #d4d4d4;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #bdbdbd;
        }

        /* Tùy chỉnh select */
        select {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22currentColor%22%3E%3Cpath%20fill-rule%3D%22evenodd%22%20d%3D%22M5.293%207.293a1%201%200%20011.414%200L10%2010.586l3.293-3.293a1%201%200%20111.414%201.414l-4%204a1%201%200%2001-1.414%200l-4-4a1%201%200%20010-1.414z%22%20clip-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E");
            background-repeat: no-repeat;
            background-position: right 0.75rem center;
            background-size: 1.5em 1.5em;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-stone-50 to-gray-100 font-sans text-gray-800 min-h-screen">

    <div class="max-w-8xl mx-auto px-4 py-10 sm:py-12">
      
 <div class="bg-white p-6 rounded-3xl shadow-lg border border-stone-100 mb-8 transform hover:scale-[1.005] transition-transform duration-300 ease-in-out">
    <form action="/mon-an" method="GET" class="flex flex-col md:flex-row justify-between items-center mb-6 gap-6 w-full">
        <!-- Ô tìm kiếm -->
        <div class="relative w-full md:w-auto flex-grow">
            <input 
                type="text" 
                name="timKiem" 
                placeholder="Nhập tên món, mô tả hoặc loại món..." 
                value="<%= filters.timKiem || '' %>" 
                class="w-full px-5 py-2.5 border border-stone-300 rounded-full focus:outline-none focus:ring-2 focus:ring-yellow-400"
            >
            <button 
                type="submit" 
                class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-2 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition"
            >
                <i class="fas fa-search"></i>
            </button>
        </div>

        <!-- Bộ lọc loại món và nút xóa -->
        <div class="flex flex-col sm:flex-row flex-wrap items-center gap-4 sm:gap-6 w-full md:w-auto justify-center">
            <!-- Bộ lọc loại món -->
            <div class="relative flex items-center gap-3 text-sm whitespace-nowrap w-full sm:w-auto">
                <span class="font-bold text-stone-700">Loại món:</span>
                <select 
                    name="loaiMon" 
                    onchange="this.form.submit()" 
                    class="block w-full sm:w-auto px-4 py-2.5 border border-stone-300 rounded-full focus:outline-none focus:ring-2 focus:ring-yellow-400"
                >
                    <option value="" <%= !filters.loaiMon ? 'selected' : '' %>>Tất cả</option>
                    <% if (categories && categories.length > 0) { %>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.SLUG_LM %>" <%= filters.loaiMon === cat.SLUG_LM ? 'selected' : '' %>>
                                <%= cat.TEN_LM %>
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <!-- Nút xóa bộ lọc -->
            <a 
                href="/mon-an" 
                class="px-4 py-2 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition"
            >
                Xóa bộ lọc
            </a>
        </div>
    </form>
</div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <% if (monAnList && monAnList.length > 0) { %>
                <% monAnList.forEach(mon => { %>
                    <%- include("../partials/mon-an-card", { mon: mon }) %>
                <% }) %>
            <% } else { %>
                <div class="col-span-full bg-white p-8 rounded-2xl shadow-lg border border-stone-200 text-center flex flex-col items-center justify-center min-h-[200px]">
                    <i class="fas fa-exclamation-circle text-6xl text-gray-400 mb-4"></i>
                    <p class="text-xl font-semibold text-gray-700">Không tìm thấy món ăn nào phù hợp với tiêu chí của bạn.</p>
                    <p class="text-gray-500 mt-2">Hãy thử thay đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
                </div>
            <% } %>
        </div>

    <% if (pagination && pagination.totalPages > 1) { %>
    <div class="flex justify-center mt-12 space-x-2">
        <% if (pagination.currentPage > 1) { %>
            <a href="?page=<%= pagination.currentPage - 1 %>&timKiem=<%= filters.timKiem || '' %>&loaiMon=<%= filters.loaiMon || '' %>"
               class="px-4 py-2 bg-yellow-500 rounded-full text-white font-semibold hover:bg-yellow-600 text-base shadow-md transition-all duration-200 flex items-center justify-center">
                <i class="fas fa-chevron-left"></i>
            </a>
        <% } %>

        <%
            const maxPageButtons = 5;
            let startPage = Math.max(1, pagination.currentPage - Math.floor(maxPageButtons / 2));
            let endPage = Math.min(pagination.totalPages, startPage + maxPageButtons - 1);

            if (endPage - startPage < maxPageButtons - 1) {
                startPage = Math.max(1, pagination.totalPages - maxPageButtons + 1);
            }

            if (startPage > 1) {
        %>
            <a href="?page=1&timKiem=<%= filters.timKiem || '' %>&loaiMon=<%= filters.loaiMon || '' %>"
               class="px-4 py-2 rounded-full text-base font-semibold transition-all duration-200
                     bg-white border border-yellow-500 text-gray-700 hover:bg-yellow-100 hover:border-yellow-600">1</a>
            <% if (startPage > 2) { %>
                <span class="px-2 py-1.5 text-gray-500 text-lg">...</span>
            <% } %>
        <% } %>

        <% for (let i = startPage; i <= endPage; i++) { %>
            <a href="?page=<%= i %>&timKiem=<%= filters.timKiem || '' %>&loaiMon=<%= filters.loaiMon || '' %>"
               class="px-4 py-2 rounded-full text-base font-semibold transition-all duration-200
                     <%= i === pagination.currentPage ? 'bg-yellow-500 text-white shadow-md' : 'bg-white border border-yellow-500 text-gray-700 hover:bg-yellow-100 hover:border-yellow-600' %>">
                <%= i %>
            </a>
        <% } %>

        <% if (endPage < pagination.totalPages) { %>
            <% if (endPage < pagination.totalPages - 1) { %>
                <span class="px-2 py-1.5 text-gray-500 text-lg">...</span>
            <% } %>
            <a href="?page=<%= pagination.totalPages %>&timKiem=<%= filters.timKiem || '' %>&loaiMon=<%= filters.loaiMon || '' %>"
               class="px-4 py-2 rounded-full text-base font-semibold transition-all duration-200
                     bg-white border border-yellow-500 text-gray-700 hover:bg-yellow-100 hover:border-yellow-600">
                <%= pagination.totalPages %>
            </a>
        <% } %>

        <% if (pagination.currentPage < pagination.totalPages) { %>
            <a href="?page=<%= pagination.currentPage + 1 %>&timKiem=<%= filters.timKiem || '' %>&loaiMon=<%= filters.loaiMon || '' %>"
               class="px-4 py-2 bg-yellow-500 rounded-full text-white font-semibold hover:bg-yellow-600 text-base shadow-md transition-all duration-200 flex items-center justify-center">
                <i class="fas fa-chevron-right"></i>
            </a>
        <% } %>
    </div>
<% } %>


    </div>

</body>
</html>