<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Người Dùng</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <style>
        /* Custom styles for smaller fonts/padding within table for compactness */
        .table-compact th,
        .table-compact td {
            padding-left: 0.5rem;
            /* px-2 */
            padding-right: 0.5rem;
            /* px-2 */
            padding-top: 0.375rem;
            /* py-1.5 */
            padding-bottom: 0.375rem;
            /* py-1.5 */
        }

        .table-compact .text-xs-custom {
            font-size: 0.6875rem;
            /* Slightly smaller than default xs (0.75rem) */
        }
    </style>
</head>

<body class="p-3 font-sans bg-gray-50">
    <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-3">
            <h1 class="text-xl font-bold text-gray-800">Danh Sách Người Dùng</h1>
            <button onclick="openAddUserModal()"
                class="px-3 py-1.5 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition duration-200 text-sm">
                ➕ Thêm Người Dùng
            </button>
        </div>

        <div class="flex flex-col md:flex-row justify-between items-center mb-4 space-y-2 md:space-y-0 md:space-x-4">
            <div class="w-full md:w-1/3">
                <input type="text" id="searchInput" onkeyup="filterUsers()"
                    placeholder="Tìm kiếm theo Tên, Email, SĐT, ID..."
                    class="w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition" />
            </div>
            <div class="w-full md:w-1/4">
                <select id="roleFilter" onchange="filterUsers()"
                    class="w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition">
                    <option value="">Lọc theo Vai trò</option>
                    <option value="admin">Admin</option>
                    <option value="người dùng">Người dùng</option>
                </select>
            </div>
            <div class="w-full md:w-1/4">
                <select id="statusFilter" onchange="filterUsers()"
                    class="w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition">
                    <option value="">Lọc theo Trạng thái</option>
                    <option value="hoạt động">Hoạt động</option>
                    <option value="bị khóa">Bị khóa</option>
                </select>
            </div>
        </div>
        <div class="overflow-x-auto rounded-lg shadow-sm border border-gray-300">
            <table class="min-w-full bg-white table-compact">
                <thead class="bg-gray-100 text-gray-700 uppercase text-xs-custom font-semibold">
                    <tr>
                        <th class="px-2 py-1.5 text-left border-r border-gray-200 w-12">ID</th>
                        <th class="px-2 py-1.5 text-left border-r border-gray-200 w-32">Tên Người Dùng</th>
                        <th class="px-2 py-1.5 text-left border-r border-gray-200 w-48">Email</th>
                        <th class="px-2 py-1.5 text-left border-r border-gray-200 w-28">SĐT</th>
                        <th class="px-2 py-1.5 text-left border-r border-gray-200 w-20">Avatar</th>
                        <th class="px-2 py-1.5 text-left border-r border-gray-200 w-24">Vai Trò</th>
                        <th class="px-2 py-1.5 text-left border-r border-gray-200 w-24">Trạng Thái</th>
                        <th class="px-2 py-1.5 text-left border-r border-gray-200 w-32">Ngày Tạo</th>
                        <th class="px-2 py-1.5 text-left border-r border-gray-200 w-32">Ngày Cập Nhật</th>
                        <th class="px-2 py-1.5 text-left w-32">Hành động</th>
                    </tr>
                </thead>
                <tbody class="text-gray-800 text-xs" id="userTableBody">
                    <% if (users && users.length> 0) { %>
                        <% users.forEach(user=> { %>
                            <tr class="hover:bg-yellow-50 transition duration-200 user-row">
                                <td class="px-2 py-1.5 border-t border-gray-200 user-id">
                                    <%= user.ID_CHINH_ND %>
                                </td>
                                <td class="px-2 py-1.5 border-t border-gray-200 user-name">
                                    <%= user.TEN_NGUOI_DUNG %>
                                </td>
                                <td class="px-2 py-1.5 border-t border-gray-200 user-email">
                                    <%= user.EMAIL_ %>
                                </td>
                                <td class="px-2 py-1.5 border-t border-gray-200 user-phone">
                                    <%= user.SO_DIEN_THOAI_ ? user.SO_DIEN_THOAI_.slice(0, 3) + '****' +
                                        user.SO_DIEN_THOAI_.slice(-3) : 'Chưa có' %>
                                </td>

                                <td class="px-2 py-1.5 border-t border-gray-200">
                                    <% if (user.AVARTAR_URL) { %>
                                        <a href="<%= user.AVARTAR_URL %>" target="_blank">
                                            <img src="<%= user.AVARTAR_URL %>" alt="Avatar người dùng"
                                                class="w-8 h-8 object-cover rounded shadow-sm hover:scale-105 transition transform" />
                                        </a>
                                        <% } else { %>
                                            <span class="text-gray-400 italic">Không có</span>
                                            <% } %>
                                </td>
                                <td class="px-2 py-1.5 border-t border-gray-200">
                                    <span
                                        class="px-1.5 py-0.5 rounded-full text-white text-xs-custom break-words inline-block text-center role-span
                                        <%= user.VAI_TRO === 'admin' ? 'bg-blue-500' : 'bg-gray-500' %>">
                                        <%= user.VAI_TRO==='admin' ? 'Admin' : 'Người dùng' %>
                                    </span>
                                </td>

                                <td class="px-2 py-1.5 border-t border-gray-200">
                                    <span
                                        class="px-1.5 py-0.5 rounded-full text-white text-xs-custom status-span
                                        <%= user.TRANG_THAI === 'hoatdong' ? 'bg-green-500' : (user.TRANG_THAI === 'khoa' ? 'bg-red-500' : 'bg-gray-400') %>">
                                        <%= user.TRANG_THAI==='hoatdong' ? 'Hoạt động' : (user.TRANG_THAI==='khoa' ?
                                        'Bị khóa' : 'Không có' ) %>
                                    </span>
                                </td>
                                <td class="px-2 py-1.5 border-t border-gray-200 text-xs-custom">
                                    <%= user.NGAY_TAO_ND ? new Date(user.NGAY_TAO_ND).toLocaleString('vi-VN') :
                                    'Chưa có' %>
                                </td>
                                <td class="px-2 py-1.5 border-t border-gray-200 text-xs-custom">
                                    <%= user.NGAY_CAP_NHAT_ND ? new
                                    Date(user.NGAY_CAP_NHAT_ND).toLocaleString('vi-VN') : 'Chưa có' %>
                                </td>
                                <td class="px-2 py-1.5 border-t border-gray-200">
                                    <div class="flex flex-col space-y-1">
                                        <button onclick="openEditUserModal('<%= user.ID_CHINH_ND %>')"
                                            class="bg-yellow-400 hover:bg-yellow-500 text-white px-2 py-1 text-xs rounded transition w-full">
                                            ✏ Sửa
                                        </button>
                                        <button onclick="confirmDeleteUser('<%= user.ID_CHINH_ND %>')"
                                            class="bg-red-600 hover:bg-red-700 text-white px-2 py-1 text-xs rounded transition w-full">
                                            🗑 Xóa
                                        </button>
                                    </div>
                                </td>

                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr class="no-user-found-message">
                                        <td colspan="10" class="text-center py-3 text-gray-400 italic text-sm">Không
                                            có người dùng nào!</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
            <div class="mt-4 flex justify-center space-x-2">
                <% if (currentPage> 1) { %>
                    <a href="#"
                        onclick="loadPage('/admin/nguoi-dung?page=<%= currentPage - 1 %>', document.querySelector('#content')); return false;"
                        class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition text-sm">
                        ‹ Trước
                    </a>
                    <% } %>
                        <% for (let i=1; i <=totalPages; i++) { %>
                            <a href="#"
                                onclick="loadPage('/admin/nguoi-dung?page=<%= i %>', document.querySelector('#content')); return false;"
                                class="px-2.5 py-1 rounded-lg border text-sm <%= i === currentPage ? 'bg-yellow-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100' %>">
                                <%= i %>
                            </a>
                            <% } %>
                                <% if (currentPage < totalPages) { %>
                                    <a href="#"
                                        onclick="loadPage('/admin/nguoi-dung?page=<%= currentPage + 1 %>', document.querySelector('#content')); return false;"
                                        class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition text-sm">
                                        Sau ›
                                    </a>
                                    <% } %>
            </div>
            <% } %>
    </div>

    <div id="userModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center hidden">
        <div class="bg-white p-4 rounded-lg shadow-lg w-full max-w-xs">
            <h2 id="modalTitle" class="text-lg font-bold mb-3">Thêm Người Dùng</h2>
            <form id="userForm" enctype="multipart/form-data">
                <input type="hidden" id="userId" name="ID_CHINH_ND" value="">
                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-0.5">Tên người dùng</label>
                    <input type="text" id="tenNguoiDung" name="TEN_NGUOI_DUNG" placeholder="Tên người dùng" required
                        class="w-full border rounded-md p-1.5 text-sm">
                </div>
                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-0.5">Email</label>
                    <input type="email" id="email" name="EMAIL_" placeholder="Email" required
                        class="w-full border rounded-md p-1.5 text-sm">
                </div>
                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-0.5">Số điện thoại</label>
                    <input type="text" id="soDienThoai" name="SO_DIEN_THOAI_" placeholder="Số điện thoại"
                        class="w-full border rounded-md p-1.5 text-sm">
                </div>
                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-0.5">Mật khẩu</label>
                    <input type="password" id="matKhau" name="MAT_KHAU" placeholder="Mật khẩu"
                        class="w-full border rounded-md p-1.5 text-sm">
                </div>
                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-0.5">Hình ảnh</label>
                    <img id="imagePreview" src="/default.jpg"
                        class="mt-1 w-20 h-20 object-cover rounded-lg border cursor-pointer"
                        onclick="document.getElementById('hinh_anh').click()" />
                    <input type="file" id="hinh_anh" name="hinh_anh" accept="image/*" class="hidden"
                        onchange="previewImage(this, 'imagePreview')" />
                </div>
                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-0.5">Vai trò</label>
                    <select id="vaiTro" name="VAI_TRO" class="w-full border rounded-md p-1.5 text-sm">
                        <option value="nguoidung">Người dùng</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
                <div class="mb-2" id="trangThaiField" style="display: none;">
                    <label class="block text-sm font-medium text-gray-700 mb-0.5">Trạng thái</label>
                    <select id="trangThai" name="TRANG_THAI" class="w-full border rounded-md p-1.5 text-sm">
                        <option value="hoatdong">Hoạt động</option>
                        <option value="khoa">Khóa</option>
                    </select>
                </div>
                <div class="mb-2 hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-0.5">Ngày tạo</label>
                    <input type="text" id="ngayTao" name="NGAY_TAO_ND"
                        class="w-full border rounded-md p-1.5 bg-gray-100 text-sm" readonly>
                </div>
                <div class="mb-2 hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-0.5">Ngày cập nhật</label>
                    <input type="text" id="ngayCapNhat" name="NGAY_CAP_NHAT_ND"
                        class="w-full border rounded-md p-1.5 bg-gray-100 text-sm" readonly>
                </div>
                <div class="flex justify-end items-center gap-2 mt-3">
                    <button type="button" onclick="closeUserModal()"
                        class="bg-gray-500 text-white px-2.5 py-1 rounded-md text-sm">
                        Hủy
                    </button>
                    <button type="submit" id="submitButton"
                        class="bg-blue-500 text-white px-2.5 py-1 rounded-md text-sm">
                        Thêm
                    </button>
                </div>

            </form>
        </div>
    </div>