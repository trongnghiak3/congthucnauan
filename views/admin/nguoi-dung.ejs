<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản Lý Người Dùng</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>

<body class="p-8 font-sans bg-gray-50">
  <div class="max-w-8xl mx-auto">
    <!-- Tiêu đề và nút thêm -->
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-800">Danh Sách Người Dùng</h1>
      <button onclick="openAddUserModal()"
        class="px-5 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition duration-200">
        ➕ Thêm Người Dùng
      </button>
    </div>

    <!-- Bảng người dùng -->
    <table class="min-w-full border border-gray-300 rounded-lg overflow-hidden shadow-sm bg-white">
      <thead class="bg-gray-100 text-gray-700 uppercase text-sm font-semibold">
        <tr>
          <th class="px-6 py-3 text-left border-r border-gray-300">ID</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Tên Người Dùng</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Email</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Số Điện Thoại</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Avatar</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Vai Trò</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Trạng Thái</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Ngày Tạo</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Ngày Cập Nhật</th>
          <th class="px-6 py-3 text-left">Hành động</th>
        </tr>
      </thead>
      <tbody class="text-gray-800 text-sm">
        <% if (users && users.length> 0) { %>
          <% users.forEach(user=> { %>
            <tr class="hover:bg-yellow-50 transition duration-200">
              <td class="px-6 py-3 border-t border-gray-200">
                <%= user.ID_CHINH_ND %>
              </td>
              <td class="px-6 py-3 border-t border-gray-200">
                <%= user.TEN_NGUOI_DUNG %>
              </td>
              <td class="px-6 py-3 border-t border-gray-200">
                <%= user.EMAIL_ %>
              </td>
              <td class="px-6 py-3 border-t border-gray-200">
                <%= user.SO_DIEN_THOAI_ || 'Chưa có' %>
              </td>
              <td class="px-6 py-3 border-t border-gray-200">
                <% if (user.AVARTAR_URL) { %>
                  <a href="<%= user.AVARTAR_URL %>" target="_blank">
                    <img src="<%= user.AVARTAR_URL %>" alt="Avatar người dùng"
                      class="w-14 h-14 object-cover rounded shadow-sm hover:scale-105 transition transform" />
                  </a>
                  <% } else { %>
                    <span class="text-gray-400 italic">Không có</span>
                    <% } %>
              </td>
              <td class="px-6 py-3 border-t border-gray-200">
                <span class="px-2 py-1 rounded-full text-white text-xs break-words inline-block text-center
    <%= user.VAI_TRO === 'admin' ? 'bg-blue-500' : 'bg-gray-500' %>">
                  <%= user.VAI_TRO==='admin' ? 'Admin' : 'Người dùng' %>
                </span>
              </td>

              <td class="px-6 py-3 border-t border-gray-200">
                <span
                  class="px-2 py-1 rounded-full text-white text-xs
                  <%= user.TRANG_THAI === 'hoatdong' ? 'bg-green-500' : (user.TRANG_THAI === 'khoa' ? 'bg-red-500' : 'bg-gray-400') %>">
                  <%= user.TRANG_THAI==='hoatdong' ? 'Hoạt động' : (user.TRANG_THAI==='khoa' ? 'Bị khóa' : 'Không có' )
                    %>
                </span>
              </td>
              <td class="px-6 py-3 border-t border-gray-200">
                <%= user.NGAY_TAO_ND ? new Date(user.NGAY_TAO_ND).toLocaleString('vi-VN') : 'Chưa có' %>
              </td>
              <td class="px-6 py-3 border-t border-gray-200">
                <%= user.NGAY_CAP_NHAT_ND ? new Date(user.NGAY_CAP_NHAT_ND).toLocaleString('vi-VN') : 'Chưa có' %>
              </td>
              <td class="px-6 py-3 border-t border-gray-200">
  <div class="flex space-x-2">
    <button onclick="openEditUserModal('<%= user.ID_CHINH_ND %>')"
      class="bg-yellow-400 hover:bg-yellow-500 text-white px-3 py-2 rounded-md transition">
      ✏ Sửa
    </button>
    <button onclick="confirmDeleteUser('<%= user.ID_CHINH_ND %>')"
      class="bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-md transition">
      🗑 Xóa
    </button>
  </div>
</td>

            </tr>
            <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="10" class="text-center py-6 text-gray-400 italic">Không có người dùng nào!</td>
                </tr>
                <% } %>
      </tbody>
    </table>

    <!-- Phân trang -->
    <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
      <div class="mt-6 flex justify-center space-x-2">
        <% if (currentPage> 1) { %>
          <a href="#"
            onclick="loadPage('/admin/nguoi-dung?page=<%= currentPage - 1 %>', document.querySelector('#content')); return false;"
            class="px-4 py-2 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition">
            ‹ Trước
          </a>
          <% } %>
            <% for (let i=1; i <=totalPages; i++) { %>
              <a href="#"
                onclick="loadPage('/admin/nguoi-dung?page=<%= i %>', document.querySelector('#content')); return false;"
                class="px-4 py-2 rounded-lg border text-sm <%= i === currentPage ? 'bg-yellow-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100' %>">
                <%= i %>
              </a>
              <% } %>
                <% if (currentPage < totalPages) { %>
                  <a href="#"
                    onclick="loadPage('/admin/nguoi-dung?page=<%= currentPage + 1 %>', document.querySelector('#content')); return false;"
                    class="px-4 py-2 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition">
                    Sau ›
                  </a>
                  <% } %>
      </div>
      <% } %>
  </div>

  <!-- Modal Thêm/Sửa Người Dùng -->
  <div id="userModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center hidden">
    <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-md">
      <h2 id="modalTitle" class="text-xl font-bold mb-4">Thêm Người Dùng</h2>
      <form id="userForm" enctype="multipart/form-data">
        <input type="hidden" id="userId" name="ID_CHINH_ND" value="">
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Tên người dùng</label>
          <input type="text" id="tenNguoiDung" name="TEN_NGUOI_DUNG" placeholder="Tên người dùng" required
            class="w-full border rounded-lg p-2">
        </div>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" id="email" name="EMAIL_" placeholder="Email" required
            class="w-full border rounded-lg p-2">
        </div>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Số điện thoại</label>
          <input type="text" id="soDienThoai" name="SO_DIEN_THOAI_" placeholder="Số điện thoại"
            class="w-full border rounded-lg p-2">
        </div>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu</label>
          <input type="password" id="matKhau" name="MAT_KHAU" placeholder="Mật khẩu"
            class="w-full border rounded-lg p-2">
        </div>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Hình ảnh</label>
          <img id="imagePreview" src="/default.jpg" class="mt-2 w-40 h-40 object-cover rounded-lg border cursor-pointer"
            onclick="document.getElementById('hinh_anh').click()" />
          <input type="file" id="hinh_anh" name="hinh_anh" accept="image/*" class="hidden"
            onchange="previewImage(this, 'imagePreview')" />
        </div>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Vai trò</label>
          <select id="vaiTro" name="VAI_TRO" class="w-full border rounded-lg p-2 text-sm">
            <option value="nguoidung">Người dùng</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div class="mb-4" id="trangThaiField" style="display: none;">
          <label class="block text-sm font-medium text-gray-700 mb-1">Trạng thái</label>
          <select id="trangThai" name="TRANG_THAI" class="w-full border rounded-lg p-2">
            <option value="hoatdong">Hoạt động</option>
            <option value="khoa">Khóa</option>
          </select>
        </div>
        <div class="mb-4 hidden">
          <label class="block text-sm font-medium text-gray-700 mb-1">Ngày tạo</label>
          <input type="text" id="ngayTao" name="NGAY_TAO_ND" class="w-full border rounded-lg p-2 bg-gray-100" readonly>
        </div>
        <div class="mb-4 hidden">
          <label class="block text-sm font-medium text-gray-700 mb-1">Ngày cập nhật</label>
          <input type="text" id="ngayCapNhat" name="NGAY_CAP_NHAT_ND" class="w-full border rounded-lg p-2 bg-gray-100"
            readonly>
        </div>
       <div class="flex justify-end items-center gap-2 flex-wrap md:flex-nowrap">
  <button type="button" onclick="closeUserModal()"
    class="bg-gray-500 text-white px-4 py-2 rounded-lg whitespace-nowrap">
    Hủy
  </button>
  <button type="submit" id="submitButton"
    class="bg-blue-500 text-white px-4 py-2 rounded-lg whitespace-nowrap">
    Thêm
  </button>
</div>

      </form>
    </div>
  </div>
</body>

</html>