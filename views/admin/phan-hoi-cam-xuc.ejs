<div id="reply-emotions-by-recipe" class="tab-content" role="tabpanel">
  <div class="flex justify-between items-center px-4 py-2 bg-white border-b border-gray-200">
    <div class="text-gray-600 text-xs">
      Tổng công thức có phản hồi cảm xúc:
      <span class="font-semibold text-gray-800">
        <%= Object.keys(groupedEmotions).length %>
      </span>
    </div>
  </div>

  <div class="overflow-x-auto px-4 py-2 bg-white border border-t-0 rounded-b-lg">
    <table class="min-w-full text-sm text-gray-700">
      <thead>
        <tr class="bg-gray-100 text-gray-700 uppercase text-xs font-semibold">
          <th class="px-4 py-2 text-center">STT</th>
          <th class="px-4 py-2 text-left">Người Dùng</th>
          <th class="px-4 py-2 text-left">Phản Hồi</th>
          <th class="px-4 py-2 text-left">Loại Cảm Xúc</th>
          <th class="px-4 py-2 text-center">Ngày</th>
        </tr>
      </thead>
      <tbody>
        <% if (groupedEmotions && Object.keys(groupedEmotions).length > 0) { %>
          <% Object.keys(groupedEmotions).forEach((tenCT, index) => {
            const list = groupedEmotions[tenCT];
          %>
            <tr class="hover:bg-yellow-50 cursor-pointer bg-gray-50" onclick="toggleReplyEmotions('<%= tenCT %>')">
              <td colspan="5" class="text-center font-medium py-2 text-sm">
                🍽 Công thức: <%= tenCT %>
              </td>
            </tr>
            <% list.forEach((emo, i) => { %>
              <tr class="emotion-row hidden border-b border-gray-100 text-sm" data-group="<%= tenCT %>">
                <td class="p-2 text-center"><%= i + 1 %></td>
                <td class="p-2"><%= emo.TEN_NGUOI_DUNG %> – <%= emo.EMAIL_ %></td>
                <td class="p-2 comment-content leading-relaxed">
                  <div class="font-normal text-gray-800 text-sm" title="<%= emo.NOI_DUNG_PH %>">
                    <%= emo.NOI_DUNG_PH %>
                  </div>
                  <% if (emo.NOI_DUNG_PH_CHA) { %>
                    <div class="text-gray-500 italic text-xs mt-0.5" title="<%= emo.NOI_DUNG_PH_CHA %>">
                      ↪ Trả lời: <%= emo.NOI_DUNG_PH_CHA %>
                    </div>
                  <% } else if (emo.NOI_DUNG_BL) { %>
                    <div class="text-gray-500 italic text-xs mt-0.5" title="<%= emo.NOI_DUNG_BL %>">
                      🗨 Bình luận: <%= emo.NOI_DUNG_BL %>
                    </div>
                  <% } %>
                </td>
                <td class="p-2">
                  <%
                    const emotionIcons = {
                      like: '👍',
                      love: '❤️',
                      haha: '😂',
                      wow: '😮',
                      sad: '😢',
                      angry: '😣'
                    };
                    const emotion = emo.LOAI_CAM_XUC.toLowerCase();
                  %>
                  <%= emotionIcons[emotion] || emotion %>
                </td>
                <td class="p-2 text-center">
                  <%= new Date(emo.NGAY_TAO_CX_PH).toLocaleDateString('vi-VN') %>
                </td>
              </tr>
            <% }) %>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-4 text-gray-400 italic text-sm">Không có phản hồi cảm xúc nào.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <div class="mt-4 flex justify-center space-x-2">
      <% if (currentPage > 1) { %>
        <a href="#"
          onclick="loadPage('/admin/phan-hoi-cam-xuc?page=<%= currentPage - 1 %>', document.querySelector('#content')); return false;"
          class="px-3 py-1 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition text-sm">‹ Trước</a>
      <% } %>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="#"
          onclick="loadPage('/admin/phan-hoi-cam-xuc?page=<%= i %>', document.querySelector('#content')); return false;"
          class="px-3 py-1 rounded-lg border text-sm <%= i === currentPage ? 'bg-yellow-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100' %>">
          <%= i %>
        </a>
      <% } %>
      <% if (currentPage < totalPages) { %>
        <a href="#"
          onclick="loadPage('/admin/phan-hoi-cam-xuc?page=<%= currentPage + 1 %>', document.querySelector('#content')); return false;"
          class="px-3 py-1 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition text-sm">Sau ›</a>
      <% } %>
    </div>
  <% } %>
</div>