<div class="bg-white rounded-lg shadow-lg p-6">
  <h2 class="text-2xl font-bold text-gray-800 mb-6">Danh Sách Thông Báo</h2>
  
  <!-- Thanh tìm kiếm và bộ lọc -->
  <div class="flex justify-between items-center mb-6">
    <div class="relative w-1/3">
      <input type="text" id="search-notifications" placeholder="Tìm kiếm thông báo..." 
             class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-yellow-500"
             value="<%= search || '' %>">
      <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
    </div>
    <div>
      <select id="filter-notifications" class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-yellow-500">
        <option value="all" <%= filter === 'all' ? 'selected' : '' %>>Tất cả</option>
        <option value="unread" <%= filter === 'unread' ? 'selected' : '' %>>Chưa đọc</option>
        <option value="read" <%= filter === 'read' ? 'selected' : '' %>>Đã đọc</option>
      </select>
    </div>
  </div>

  <!-- Danh sách thông báo -->
  <div id="notification-list" class="space-y-4">
    <% if (notifications && notifications.length > 0) { %>
      <% notifications.forEach(notification => { %>
        <div class="notification-item flex items-start gap-4 p-4 rounded-lg bg-gray-50 border border-gray-200 hover:bg-gray-100 transition <%= notification.read ? 'opacity-75' : '' %>">
          <i class="fas fa-bell text-yellow-500 text-xl"></i>
          <div class="flex-1">
            <p class="text-gray-800 font-medium"><%= notification.message %></p>
            <p class="text-gray-500 text-sm"><%= new Date(notification.date).toLocaleString('vi-VN') %></p>
          </div>
          <div class="flex items-center gap-2">
            <button class="mark-read-btn text-blue-500 hover:text-blue-700" title="Đánh dấu đã đọc" 
                    data-id="<%= notification.id %>" data-type="<%= notification.type %>">
              <i class="fas fa-check-circle"></i>
            </button>
            <button class="delete-btn text-red-500 hover:text-red-700" title="Xóa thông báo" 
                    data-id="<%= notification.id %>" data-type="<%= notification.type %>">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div id="no-notifications" class="text-center text-gray-500 py-8">
        Không có thông báo nào.
      </div>
    <% } %>
  </div>

  <!-- Phân trang -->
  <div class="mt-6 flex justify-center">
    <nav class="flex items-center gap-2">
      <a href="/admin/thong-bao?page=<%= currentPage > 1 ? currentPage - 1 : 1 %><%= filter ? '&filter=' + filter : '' %><%= search ? '&search=' + search : '' %>" 
         class="px-4 py-2 bg-yellow-500 text-white rounded-lg <%= currentPage === 1 ? 'opacity-50 cursor-not-allowed' : '' %>"
         <%= currentPage === 1 ? 'disabled' : '' %> onclick="event.preventDefault(); loadPage(this.href, this)">Trước</a>
      <span class="px-4 py-2 text-gray-700">Trang <%= currentPage %> / <%= totalPages %></span>
      <a href="/admin/thong-bao?page=<%= currentPage < totalPages ? currentPage + 1 : totalPages %><%= filter ? '&filter=' + filter : '' %><%= search ? '&search=' + search : '' %>" 
         class="px-4 py-2 bg-yellow-500 text-white rounded-lg <%= currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : '' %>"
         <%= currentPage === totalPages ? 'disabled' : '' %> onclick="event.preventDefault(); loadPage(this.href, this)">Sau</a>
    </nav>
  </div>
</div>

