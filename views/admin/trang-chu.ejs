</div>

<!-- Card: Phản hồi cảm xúc -->
<div class="bg-gradient-to-r from-sky-500 to-indigo-600 rounded-xl shadow-lg p-5 text-white flex flex-col items-center justify-center transition-transform transform hover:scale-105 duration-300">
