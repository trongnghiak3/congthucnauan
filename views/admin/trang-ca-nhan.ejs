<form id="userForm" enctype="multipart/form-data" class="flex flex-col lg:flex-row h-full">
  <!-- Cột trái -->
  <div class="w-full lg:w-2/5 bg-yellow-50 p-10 flex flex-col items-center text-center rounded-l-xl">
    <h2 class="text-2xl font-bold text-yellow-700 mb-6">Ảnh đại diện</h2>

    <% if (user.AVARTAR_URL) { %>
      <img src="<%= user.AVARTAR_URL %>" alt="Avatar"
           class="w-60 h-60 rounded-xl shadow-md object-cover mb-4 transition-transform duration-300 hover:scale-105 hover:shadow-lg">
    <% } else { %>
      <div class="w-60 h-60 rounded-xl bg-gray-100 flex items-center justify-center text-yellow-500 mb-4 shadow-inner">
        <i class="fas fa-user text-5xl"></i>
      </div>
    <% } %>

    <label class="w-full mt-2 relative group">
      <input type="file" name="hinh_anh" accept="image/*" class="hidden peer" disabled>
      <div id="selectImageBtn"
           class="text-gray-700 text-sm border border-gray-300 bg-white group-hover:bg-gray-100 rounded-full px-3 py-2 transition-all duration-200 cursor-not-allowed opacity-50 text-center shadow-sm">
        Chọn ảnh mới
      </div>
      <!-- Tooltip -->
      <div class="absolute top-full mt-2 left-1/2 transform -translate-x-1/2 text-xs text-gray-500 bg-white border border-gray-200 rounded px-2 py-1 shadow-sm hidden group-hover:block">
        Nhấn "Chỉnh sửa" để thay đổi ảnh
      </div>
    </label>
  </div>

  <!-- Cột phải -->
  <div class="w-full lg:w-3/5 bg-white p-10 flex flex-col justify-between">
    <div>
      <h1 class="text-3xl font-bold text-yellow-600 flex items-center gap-3 mb-6">
        <i class="fas fa-user-circle"></i> Thông Tin Cá Nhân
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tên người dùng</label>
          <input type="text" id="TEN_NGUOI_DUNG" name="TEN_NGUOI_DUNG" value="<%= user.TEN_NGUOI_DUNG %>" readonly
                 class="w-full p-4 border border-gray-300 rounded-lg bg-gray-100 text-base">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" id="EMAIL_" name="EMAIL_" value="<%= user.EMAIL_ %>" readonly
                 class="w-full p-4 border border-gray-300 rounded-lg bg-gray-100 text-base">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Số điện thoại</label>
          <input type="text" id="SO_DIEN_THOAI_" name="SO_DIEN_THOAI_" value="<%= user.SO_DIEN_THOAI_ || '' %>" readonly
                 class="w-full p-4 border border-gray-300 rounded-lg bg-gray-100 text-base">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Vai trò</label>
          <input type="text" name="VAI_TRO" value="<%= user.VAI_TRO === 'admin' ? 'Quản trị viên' : 'Người dùng' %>" readonly
                 class="w-full p-4 border border-gray-300 rounded-lg bg-gray-100 text-base">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Trạng thái</label>
          <input type="text" name="TRANG_THAI" value="<%= user.TRANG_THAI === 'hoatdong' ? 'Hoạt động' : 'Khóa' %>" readonly
                 class="w-full p-4 border border-gray-300 rounded-lg bg-gray-100 text-base">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Ngày tạo</label>
          <input type="text" value="<%= new Date(user.NGAY_TAO_ND).toLocaleString('vi-VN') %>" readonly
                 class="w-full p-4 bg-gray-100 border border-gray-300 rounded-lg text-base">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Ngày cập nhật</label>
          <input type="text" value="<%= user.NGAY_CAP_NHAT_ND ? new Date(user.NGAY_CAP_NHAT_ND).toLocaleString('vi-VN') : '' %>" readonly
                 class="w-full p-4 bg-gray-100 border border-gray-300 rounded-lg text-base">
        </div>
      </div>
    </div>

    <!-- Nút -->
    <div class="flex justify-end gap-4 mt-8">
      <button type="button" id="editBtn"
              class="bg-yellow-400 hover:bg-yellow-500 text-white font-semibold py-3 px-6 rounded-lg shadow-md transition">
        ✏️ Chỉnh sửa
      </button>

      <button type="button" id="saveBtn"
              class="bg-yellow-600 hover:bg-yellow-700 text-white font-semibold py-3 px-6 rounded-lg shadow-md transition hidden">
        💾 Lưu thay đổi
      </button>

      <button type="button" id="cancelBtn"
              class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-3 px-6 rounded-lg shadow-md transition hidden">
        ❌ Thoát
      </button>
    </div>
  </div>
</form>