<div id="comments-by-recipe" class="tab-content" role="tabpanel">
  <div class="flex justify-between items-center px-6 py-4 bg-white border-b border-gray-200">
    <div class="text-gray-600 text-sm">
      Tổng công thức có bình luận:
      <span class="font-semibold text-gray-800">
        <%= Object.keys(groupedComments).length %>
      </span>
    </div>
  </div>

  <div class="overflow-x-auto px-6 py-4 bg-white border border-t-0 rounded-b-lg">
    <table class="min-w-full text-sm text-gray-700">
      <thead>
        <tr class="bg-gray-100 text-gray-700 uppercase font-medium">
          <th class="px-4 py-3 text-center">STT</th>
          <th class="px-4 py-3 text-left">Người Dùng</th>
          <th class="px-4 py-3 text-left">Nội Dung</th>
          <th class="px-4 py-3 text-center">Ngày</th>
          <th class="px-4 py-3 text-center">Hành Động</th>
        </tr>
      </thead>
      <tbody>
        <% if (groupedComments && Object.keys(groupedComments).length> 0) { %>
          <% Object.keys(groupedComments).forEach((tenCT, index)=> {
            const list = groupedComments[tenCT];
            %>
            <tr class="hover:bg-yellow-50 cursor-pointer bg-gray-50" onclick="toggleComments('<%= tenCT %>')">
              <td colspan="5" class="text-center font-medium py-3">
                🍽 <%= tenCT %>
              </td>
            </tr>
       <% list.forEach((cmt, i)=> { %>
  <tr class="comment-row hidden border-b border-gray-100" data-group="<%= tenCT %>">
    <td class="p-3 text-center">
      <%= i + 1 %>
    </td>
    <td class="p-3">
      <%= cmt.TEN_NGUOI_DUNG %> – <%= cmt.EMAIL_ %>
    </td>
    <td class="p-3">
      <%= cmt.NOI_DUNG_BL %>
    </td>
    <td class="p-3 text-center">
      <%= new Date(cmt.NGAY_TAO_BL).toLocaleDateString('vi-VN') %>
    </td>
    <td class="p-3 text-center">
      <button onclick="confirmDeleteComment('<%= cmt.ID_CHINH_BL %>')"
        class="bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-md transition">
        🗑 Xóa
      </button>
    </td>
  </tr>
<% }) %>

                <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="text-center py-6 text-gray-400 italic">Không có bình luận nào.</td>
                    </tr>
                    <% } %>
      </tbody>
    </table>
  </div>

  <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
    <div class="mt-6 flex justify-center space-x-2">
      <% if (currentPage> 1) { %>
        <a href="#"
          onclick="loadPage('/admin/binh-luan?page=<%= currentPage - 1 %>', document.querySelector('#content')); return false;"
          class="px-4 py-2 border bg-white hover:bg-gray-100">‹ Trước</a>
        <% } %>
          <% for (let i=1; i <=totalPages; i++) { %>
            <a href="#"
              onclick="loadPage('/admin/binh-luan?page=<%= i %>', document.querySelector('#content')); return false;"
              class="px-4 py-2 rounded border text-sm <%= i === currentPage ? 'bg-yellow-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100' %>">
              <%= i %>
            </a>
            <% } %>
              <% if (currentPage < totalPages) { %>
                <a href="#"
                  onclick="loadPage('/admin/binh-luan?page=<%= currentPage + 1 %>', document.querySelector('#content')); return false;"
                  class="px-4 py-2 border bg-white hover:bg-gray-100">Sau ›</a>
                <% } %>
    </div>
    <% } %>
</div>