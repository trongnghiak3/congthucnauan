<!-- Header -->
<!-- Form lọc và nút thêm công thức -->
<!-- Form lọc -->
 
<form id="searchForm" class="bg-white p-3 rounded-md shadow border flex flex-col sm:flex-row sm:items-end flex-wrap gap-3 mb-4 text-sm">

  <!-- Tên / Mô tả -->
  <div class="flex-1 min-w-[150px]">
    <label for="filterSearch" class="block text-gray-700 mb-1">Tên / Mô tả</label>
    <input type="text" id="filterSearch" placeholder="Tên hoặc mô tả"
           class="w-full border px-2 py-1 rounded focus:outline-none focus:ring-1 focus:ring-yellow-400" />
  </div>

  <!-- Tên món -->
  <div class="flex-1 min-w-[150px]">
    <label for="filterFoodName" class="block text-gray-700 mb-1">Tên món</label>
    <input type="text" id="filterFoodName" placeholder="Tên món ăn"
           class="w-full border px-2 py-1 rounded focus:outline-none focus:ring-1 focus:ring-yellow-400" />
  </div>

  <!-- Ngày tạo -->
  <div class="min-w-[140px]">
    <label for="filterDate" class="block text-gray-700 mb-1">Ngày tạo</label>
    <input type="date" id="filterDate"
           class="w-full border px-2 py-1 rounded focus:outline-none focus:ring-1 focus:ring-yellow-400" />
  </div>

  <!-- Người tạo -->
  <div class="min-w-[140px]">
    <label for="filterCreator" class="block text-gray-700 mb-1">Người tạo</label>
    <select id="filterCreator"
            class="w-full border px-2 py-1 rounded focus:outline-none focus:ring-1 focus:ring-yellow-400">
      <option value="">Tất cả</option>
      <option value="me">Tôi</option>
      <option value="admin">Admin khác</option>
      <option value="nguoidung">Người dùng</option>
    </select>
  </div>

  <!-- Trạng thái duyệt -->
  <div class="min-w-[140px]">
    <label for="filterStatus" class="block text-gray-700 mb-1">Trạng thái</label>
    <select id="filterStatus"
            class="w-full border px-2 py-1 rounded focus:outline-none focus:ring-1 focus:ring-yellow-400">
      <option value="">Tất cả</option>
      <option value="Đang chờ duyệt">Đang chờ</option>
      <option value="Đã duyệt">Đã duyệt</option>
      <option value="Từ chối">Từ chối</option>
    </select>
  </div>

  <!-- Nút hành động -->
  <div class="flex flex-wrap gap-2 mt-1">
    <button type="button" onclick="filterRecipes()"
            class="bg-yellow-500 text-white px-3 py-1 rounded hover:bg-yellow-600">
      <i class="fas fa-filter mr-1"></i> Lọc
    </button>

    <button type="button" onclick="resetSearchForm()"
            class="bg-gray-500 text-white px-3 py-1 rounded hover:bg-gray-600">
      <i class="fas fa-undo mr-1"></i> Đặt lại
    </button>

    <a href="/admin/cong-thuc/add"
       onclick="event.preventDefault(); loadPage('/admin/cong-thuc/add', this)"
       class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded inline-flex items-center gap-2">
      <i class="fas fa-plus"></i> Thêm
    </a>
  </div>
</form>






<!-- Bảng danh sách -->
<div class="flex flex-col min-h-[400px] justify-between px-4 py-3">
  <div class="overflow-x-auto">
    <table id="recipeTable" class="min-w-full border border-gray-300 rounded-lg overflow-hidden shadow-sm">
      <thead class="bg-gray-100 text-gray-700 uppercase text-xs font-medium select-none">
        <tr>
          <th class="p-1 border-r">ID</th>
          <th class="p-1 border-r">Tên Công Thức</th>
          <th class="p-1 border-r">Món Ăn</th>
          <th class="p-1 border-r">Mô Tả</th>
          <th class="p-1 border-r">Hướng Dẫn</th>
          <th class="p-1 border-r">Người Tạo</th>
          <th class="p-1 border-r">Số Phần</th>
          <th class="p-1 border-r">Thời Gian</th>
          <th class="p-1 border-r">Độ Khó</th>
          <th class="p-1 border-r">Hình Ảnh</th>
          <th class="p-1 border-r">Video</th>
          <th class="p-1 border-r">Ngày Tạo</th>
          <th class="p-1 border-r">Ngày Cập nhật</th>
          <th class="p-1 border-r">Ngày Duyệt</th>
          <th class="p-1 border-r">Lý Do Từ Chối</th>
          <th class="p-1 border-r">Trạng Thái</th>
        </tr>
      </thead>
      <tbody>
        <% if (recipes && recipes.length > 0) { %>
          <% recipes.forEach((recipe) => { %>
            <tr class="recipe-row text-xs text-gray-700 border-t hover:bg-gray-50" data-role="<%= recipe.role %>" data-id="<%= recipe.ID_CHINH_CT %>" data-owner-id="<%= recipe.ID_CHINH_ND %>">
              <td class="p-1 border-r"><%= recipe.ID_CHINH_CT %></td>
              <td class="p-1 border-r font-medium"><%= recipe.TEN_CT %></td>
              <td class="p-1 border-r"><%= recipe.TEN_MON_AN || 'Không rõ' %></td>
              <td class="p-1 border-r line-clamp-2 break-words"><%= recipe.MOTA %></td>
              <!-- Hướng dẫn -->
              <td class="p-1 border-r">
                <button onclick="toggleInstructions('<%= recipe.ID_CHINH_CT %>')" class="text-blue-500 hover:text-blue-700 text-xs">
                  Xem <span id="toggle-icon-<%= recipe.ID_CHINH_CT %>">▼</span>
                </button>
                <div id="instructions-<%= recipe.ID_CHINH_CT %>" class="hidden mt-1 text-xs bg-gray-100 p-1 rounded space-y-1">
                  <% if (recipe.HUONG_DAN) { 
                       const steps = recipe.HUONG_DAN.trim().split('\n\n');
                       steps.forEach(step => {
                         const [title, desc] = step.replace(/^Bước \d+: /, '').split(' - ');
                  %>
                    <div><strong><%= title %></strong><br /><%= desc %></div>
                  <% }); } else { %>
                    <div>Chưa có hướng dẫn nấu.</div>
                  <% } %>
                </div>
              </td>
              <td class="p-1 border-r">
                <% if (recipe.ID_CHINH_ND === user.ID_CHINH_ND) { %>
                  <span class="text-black font-semibold">Tôi</span>
                <% } else if (recipe.role === 'admin') { %>
                  <span class="text-blue-600 font-semibold">Admin:</span> 
                  <span class="font-medium"><%= recipe.user || 'Không rõ' %></span>
                <% } else if (recipe.role === 'nguoidung') { %>
                  <span class="text-yellow-600 font-semibold">Người dùng:</span> 
                  <span class="text-black font-semibold"> <%= recipe.user || 'Không rõ' %></span>
                <% } else { %>
                  <span class="text-gray-500 italic">Không rõ</span>
                <% } %>
              </td>
              <td class="p-1 border-r"><%= recipe.SO_PHAN_AN %> phần</td>
              <td class="p-1 border-r"><%= recipe.THOI_GIAN_NAU %></td>
              <td class="p-1 border-r">
                <span class="inline-block px-1 py-0.5 rounded-full text-xs
                  <%= recipe.DO_KHO === 'Dễ' ? 'bg-green-100 text-green-700' :
                      recipe.DO_KHO === 'Trung bình' ? 'bg-yellow-100 text-yellow-700' :
                      'bg-red-100 text-red-700' %>">
                  <%= recipe.DO_KHO %>
                </span>
              </td>
              <td class="p-1 border-r">
                <% if (recipe.HINH_ANH_CT) { %>
                  <a href="<%= recipe.HINH_ANH_CT %>" target="_blank">
                    <img src="<%= recipe.HINH_ANH_CT %>" alt="Ảnh món ăn" class="w-10 h-10 object-cover rounded shadow-md hover:scale-105 transition" />
                  </a>
                <% } else { %>
                  <span class="text-gray-500">Không có</span>
                <% } %>
              </td>
              <td class="p-1 border-r">
                <% if (recipe.VIDEO) { %>
                  <a href="<%= recipe.VIDEO %>" target="_blank" class="text-blue-500 hover:text-blue-700 text-xs">Xem ▶</a>
                <% } else { %>
                  <span class="text-gray-500">Không có</span>
                <% } %>
              </td>
              <td class="p-1 border-r"><%= new Date(recipe.NGAY_TAO_CT).toLocaleDateString('vi-VN') %></td>
              <td class="p-1 border-r">
                <%= recipe.NGAY_CAP_NHAT_CT ? new Date(recipe.NGAY_CAP_NHAT_CT).toLocaleDateString('vi-VN') : '--' %>
              </td>
              <td class="p-1 border-r">
                <%= recipe.NGAY_DUYET ? new Date(recipe.NGAY_DUYET).toLocaleDateString('vi-VN') : '--' %>
              </td>
              <td class="p-1 border-r text-red-500 text-xs">
                <%= recipe.LY_DO_TU_CHOI || '--' %>
              </td>
              <td class="p-1 border-r">
                <span class="inline-block px-1 py-0.5 rounded-full text-xs
                  <%= recipe.TRANG_THAI_DUYET_ === 'Đã duyệt' ? 'bg-green-100 text-green-700' :
                      recipe.TRANG_THAI_DUYET_ === 'Đang chờ duyệt' ? 'bg-yellow-100 text-yellow-700' :
                      'bg-red-100 text-red-700' %>">
                  <%= recipe.TRANG_THAI_DUYET_ %>
                </span>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="16" class="p-2 text-center text-gray-500 text-xs">Không có công thức nào để hiển thị.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<div class="flex items-center justify-center space-x-1 mt-4"> <% const visiblePages = 2; %>
<div id="pagination" class="flex flex-wrap justify-center items-center gap-2 mt-6">
  <% if (currentPage > 1) { %>
    <a href="#" data-page="<%= currentPage - 1 %>"
       class="page-link px-3 py-1 rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 text-sm transition">
      ‹ Trước
    </a>
  <% } %>

  <% if (currentPage > visiblePages + 2) { %>
    <a href="#" data-page="1"
       class="page-link px-3 py-1 rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 text-sm transition">
      1
    </a>
    <span class="px-2 py-1 text-gray-500">...</span>
  <% } %>

  <% for (let i = Math.max(1, currentPage - visiblePages); i <= Math.min(totalPages, currentPage + visiblePages); i++) { %>
    <a href="#" data-page="<%= i %>"
       class="page-link px-3 py-1 rounded-lg border border-gray-300 text-sm transition
              <%= i === currentPage ? 'bg-yellow-500 text-white font-semibold' : 'bg-white text-gray-700 hover:bg-gray-100' %>">
      <%= i %>
    </a>
  <% } %>

  <% if (currentPage < totalPages - visiblePages - 1) { %>
    <span class="px-2 py-1 text-gray-500">...</span>
    <a href="#" data-page="<%= totalPages %>"
       class="page-link px-3 py-1 rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 text-sm transition">
      <%= totalPages %>
    </a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="#" data-page="<%= currentPage + 1 %>"
       class="page-link px-3 py-1 rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 text-sm transition">
      Sau ›
    </a>
  <% } %>
</div>



</div>




</div>

<!-- Menu chuột phải -->
<ul id="contextMenu" class="absolute bg-white shadow-lg rounded-lg border border-gray-200 text-xs hidden z-50 w-40">
  <li class="px-3 py-1 hover:bg-gray-100 cursor-pointer edit-option" onclick="handleEdit()">✏️ Chỉnh sửa</li>
  <li class="px-3 py-1 hover:bg-gray-100 cursor-pointer approve-option" onclick="handleApprove()">✅ Duyệt công thức</li>
  <li class="px-3 py-1 hover:bg-gray-100 cursor-pointer text-red-600 reject-option" onclick="handleReject()">⛔ Từ chối</li>
  <li class="px-3 py-1 hover:bg-gray-100 cursor-pointer view-ingredients-option" onclick="handleViewIngredients()">🥕 Xem nguyên liệu</li>
  <li class="px-3 py-1 hover:bg-gray-100 cursor-pointer text-red-600 delete-option" onclick="handleDelete()">❌ Xóa</li>
</ul>

<!-- Modal nguyên liệu và style giữ nguyên -->
<div id="ingredientsModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
  <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md max-h-[80vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold text-yellow-600">Danh sách nguyên liệu</h2>
      <button onclick="closeIngredientsModal()" class="text-gray-500 hover:text-gray-700 text-xl">&times;</button>
    </div>
    <div id="ingredientsModalContent" class="space-y-2">
      <!-- Nội dung nguyên liệu sẽ được load bằng AJAX -->
    </div>
    <div class="mt-4 text-right">
      <button onclick="closeIngredientsModal()" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm">
        Đóng
      </button>
    </div>
  </div>
</div>

<!-- Style hỗ trợ giữ nguyên -->
<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .transform-wrapper {
    transform: scale(0.8);
    transform-origin: top left;
  }
  .hidden {
    display: none;
  }
  #contextMenu {
    position: absolute;
    z-index: 50;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    padding: 0.25rem 0;
  }
  #contextMenu li {
    padding: 0.25rem 0.75rem;
    cursor: pointer;
  }
  #contextMenu li:hover {
    background-color: #f3f4f6;
  }
</style>
<div id="errorContainer" class="fixed top-4 right-4 hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg shadow-lg z-50">
  <span id="errorMessage"></span>
  <button onclick="document.getElementById('errorContainer').classList.add('hidden')" class="ml-2 text-red-700 font-bold">&times;</button>
</div>

<script>
    // Đảm bảo biến user được gán một giá trị an toàn trước khi sử dụng
    const user = JSON.parse('<%- JSON.stringify(user || {}) %>');
    
    console.log("🔍 user từ EJS:", user);
    
    // Gán giá trị cho window.currentUserId, nếu không tồn tại thì gán rỗng
    window.currentUserId = user.ID_CHINH_ND || '';
    
    console.log("🔍 User ID từ EJS:", window.currentUserId);

    // --- THÊM DÒNG NÀY ---
    // Gọi hàm khởi tạo các sự kiện ngay sau khi đã có user ID
    initializeRecipesList();
</script>
