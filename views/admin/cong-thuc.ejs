<!-- Header -->
<div class="flex justify-between items-center px-4 py-3 bg-gray-50 shadow-sm">
  <div></div>
  <a href="/admin/cong-thuc/add"
     onclick="event.preventDefault(); loadPage('/admin/cong-thuc/add', this)"
     class="flex justify-end bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-sm transition duration-300 ease-in-out shadow-md">
    Thêm Công Thức
  </a>
</div>

<!-- Bảng danh sách -->
<div class="flex flex-col min-h-[400px] justify-between px-4 py-3">
  <div class="overflow-x-auto">
    <table class="min-w-full border border-gray-300 rounded-lg overflow-hidden shadow-sm">
      <thead class="bg-gray-100 text-gray-700 uppercase text-xs font-medium select-none">
        <tr>
          <th class="p-1 border-r">ID</th>
          <th class="p-1 border-r">Tên Công Thức</th>
          <th class="p-1 border-r">Món Ăn</th>
          <th class="p-1 border-r">Mô Tả</th>
          <th class="p-1 border-r">Hướng Dẫn</th>
          <th class="p-1 border-r">Người Tạo</th>
          <th class="p-1 border-r">Số Phần</th>
          <th class="p-1 border-r">Thời Gian</th>
          <th class="p-1 border-r">Độ Khó</th>
          <th class="p-1 border-r">Hình Ảnh</th>
          <th class="p-1 border-r">Video</th>
          <th class="p-1 border-r">Ngày Tạo</th>
          <th class="p-1 border-r">Ngày Cập nhật</th>
          <th class="p-1 border-r">Trạng Thái</th>
          <th class="p-1">Hành Động</th>
        </tr>
      </thead>
      <tbody>
        <% if (recipes && recipes.length > 0) { %>
          <% recipes.forEach((recipe) => { %>
            <tr class="text-xs text-gray-700 border-t hover:bg-gray-50">
              <td class="p-1 border-r"><%= recipe.ID_CHINH_CT %></td>
              <td class="p-1 border-r font-medium"><%= recipe.TEN_CT %></td>
              <td class="p-1 border-r"><%= recipe.TEN_MON_AN || 'Không rõ' %></td>
              <td class="p-1 border-r line-clamp-2 break-words"><%= recipe.MOTA %></td>

              <!-- Hướng dẫn -->
              <td class="p-1 border-r">
                <button onclick="toggleInstructions('<%= recipe.ID_CHINH_CT %>')" class="text-blue-500 hover:text-blue-700 text-xs">
                  Xem <span id="toggle-icon-<%= recipe.ID_CHINH_CT %>">▼</span>
                </button>
                <div id="instructions-<%= recipe.ID_CHINH_CT %>" class="hidden mt-1 text-xs bg-gray-100 p-1 rounded space-y-1">
                  <% if (recipe.HUONG_DAN) { 
                       const steps = recipe.HUONG_DAN.trim().split('\n\n');
                       steps.forEach(step => {
                         const [title, desc] = step.replace(/^Bước \d+: /, '').split(' - ');
                  %>
                    <div><strong><%= title %></strong><br /><%= desc %></div>
                  <% }); } else { %>
                    <div>Chưa có hướng dẫn nấu.</div>
                  <% } %>
                </div>
              </td>

              <!-- Người tạo -->
              <td class="p-1 border-r">
                <% if (recipe.ID_CHINH_ND === user.ID_CHINH_ND) { %>
                  <span class="text-black font-semibold">Tôi</span>
                <% } else if (recipe.role === 'admin') { %>
                  <span class="text-blue-600 font-semibold">Admin</span>
                <% } else { %>
                  <span class="text-yellow-600 font-semibold"><%= recipe.user || 'Không rõ' %></span>
                <% } %>
              </td>

              <td class="p-1 border-r"><%= recipe.SO_PHAN_AN %> phần</td>
              <td class="p-1 border-r"><%= recipe.THOI_GIAN_NAU %></td>
              <td class="p-1 border-r">
                <span class="inline-block px-1 py-0.5 rounded-full text-xs
                  <%= recipe.DO_KHO === 'Dễ' ? 'bg-green-100 text-green-700' :
                      recipe.DO_KHO === 'Trung bình' ? 'bg-yellow-100 text-yellow-700' :
                      'bg-red-100 text-red-700' %>">
                  <%= recipe.DO_KHO %>
                </span>
              </td>

              <!-- Hình ảnh -->
              <td class="p-1 border-r">
                <% if (recipe.HINH_ANH_CT) { %>
                  <a href="<%= recipe.HINH_ANH_CT %>" target="_blank">
                    <img src="<%= recipe.HINH_ANH_CT %>" alt="Ảnh món ăn" class="w-10 h-10 object-cover rounded shadow-md hover:scale-105 transition" />
                  </a>
                <% } else { %>
                  <span class="text-gray-500">Không có</span>
                <% } %>
              </td>

              <!-- Video -->
              <td class="p-1 border-r">
                <% if (recipe.VIDEO) { %>
                  <a href="<%= recipe.VIDEO %>" target="_blank" class="text-blue-500 hover:text-blue-700 text-xs">Xem ▶</a>
                <% } else { %>
                  <span class="text-gray-500">Không có</span>
                <% } %>
              </td>

              <td class="p-1 border-r"><%= new Date(recipe.NGAY_TAO_CT).toLocaleDateString('vi-VN') %></td>
              <td class="p-1 border-r">
                <%= recipe.NGAY_CAP_NHAT_CT ? new Date(recipe.NGAY_CAP_NHAT_CT).toLocaleDateString('vi-VN') : '--' %>
              </td>

              <!-- Trạng thái -->
              <td class="p-1 border-r">
                <span class="inline-block px-1 py-0.5 rounded-full text-xs
                  <%= recipe.TRANG_THAI_DUYET_ === 'Đã duyệt' ? 'bg-green-100 text-green-700' :
                      recipe.TRANG_THAI_DUYET_ === 'Đang chờ duyệt' ? 'bg-yellow-100 text-yellow-700' :
                      'bg-red-100 text-red-700' %>">
                  <%= recipe.TRANG_THAI_DUYET_ %>
                </span>
              </td>

              <!-- Hành động -->
              <td class="p-1">
                <div class="flex space-x-1">
                  <a href="#"
                     onclick="event.preventDefault(); loadPage('/admin/cong-thuc/edit/<%= recipe.ID_CHINH_CT %>', this)"
                     class="text-yellow-500 hover:text-yellow-600 text-xs" title="Chỉnh sửa">✏️</a>
                  <% if (recipe.TRANG_THAI_DUYET_ === 'Đang chờ duyệt') { %>
                    <button onclick="confirmApprove('<%= recipe.ID_CHINH_CT %>')" class="text-green-500 hover:text-green-600 text-xs" title="Duyệt">✅</button>
                  <% } %>
                  <button onclick="confirmDelete('<%= recipe.ID_CHINH_CT %>')" class="text-red-500 hover:text-red-600 text-xs" title="Xóa">❌</button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="15" class="p-2 text-center text-gray-500 text-xs">Không có công thức nào để hiển thị.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Phân trang -->
  <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <div class="fixed bottom-0 left-0 w-full bg-white py-2 shadow-md border-t z-50 flex justify-center space-x-1">
    <% if (currentPage > 1) { %>
      <a href="#" onclick="loadPage('/admin/cong-thuc?page=<%= currentPage - 1 %>'); return false;"
         class="px-2 py-1 rounded border text-xs bg-white text-gray-700 hover:bg-gray-100">‹ Trước</a>
    <% } %>
    <% for (let i = 1; i <= totalPages; i++) { %>
      <a href="#" onclick="loadPage('/admin/cong-thuc?page=<%= i %>'); return false;"
         class="px-2 py-1 rounded border text-xs <%= i === currentPage ? 'bg-yellow-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100' %>">
        <%= i %>
      </a>
    <% } %>
    <% if (currentPage < totalPages) { %>
      <a href="#" onclick="loadPage('/admin/cong-thuc?page=<%= currentPage + 1 %>'); return false;"
         class="px-2 py-1 rounded border text-xs bg-white text-gray-700 hover:bg-gray-100">Sau ›</a>
    <% } %>
  </div>
<% } %>

</div>

<!-- Menu chuột phải -->
<ul id="contextMenu" class="absolute bg-white shadow-lg rounded-lg border border-gray-200 text-xs hidden z-50 w-40">
  <li class="px-3 py-1 hover:bg-gray-100 cursor-pointer" onclick="handleEdit()">✏️ Chỉnh sửa</li>
  <li class="px-3 py-1 hover:bg-gray-100 cursor-pointer" onclick="handleApprove()">✅ Duyệt công thức</li>
  <li class="px-3 py-1 hover:bg-gray-100 cursor-pointer text-red-600" onclick="handleDelete()">❌ Xóa</li>
</ul>

<!-- Style hỗ trợ -->
<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .transform-wrapper {
    transform: scale(0.8);
    transform-origin: top left;
  }
</style>