<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản Lý Loại Món</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="p-8 font-sans bg-gray-50">
  <div class="max-w-8xl mx-auto">
    <!-- Tiêu đề và nút thêm -->
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-800"></h1>
      <button
        onclick="openAddCategoryModal()"
        class="px-5 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition duration-200"
      >
        ➕ Thêm Loại Món
      </button>
    </div>

    <!-- Bảng loại món -->
    <table class="min-w-full border border-gray-300 rounded-lg overflow-hidden shadow-sm bg-white">
      <thead class="bg-gray-100 text-gray-700 uppercase text-sm font-semibold">
        <tr>
          <th class="px-6 py-3 text-left border-r border-gray-300">ID</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Tên Loại Món</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Slug</th>
          <th class="px-6 py-3 text-left border-r border-gray-300">Hình Ảnh</th>
          <th class="px-6 py-3 text-left">Hành động</th>
        </tr>
      </thead>
      <tbody class="text-gray-800 text-sm">
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(category => { %>
            <tr class="hover:bg-yellow-50 transition duration-200">
              <td class="px-6 py-3 border-t border-gray-200"><%= category.ID_CHINH_LM %></td>
              <td class="px-6 py-3 border-t border-gray-200"><%= category.TEN_LM %></td>
              <td class="px-6 py-3 border-t border-gray-200"><%= category.SLUG_LM || 'Không có' %></td>
              <td class="px-6 py-3 border-t border-gray-200">
                <% if (category.HINH_ANH_LM_URL) { %>
                  <a href="<%= category.HINH_ANH_LM_URL %>" target="_blank">
                    <img
                      src="<%= category.HINH_ANH_LM_URL %>"
                      alt="Ảnh loại món"
                      class="w-14 h-14 object-cover rounded shadow-sm hover:scale-105 transition transform"
                    />
                  </a>
                <% } else { %>
                  <span class="text-gray-400 italic">Không có</span>
                <% } %>
              </td>
              <td class="px-6 py-3 border-t border-gray-200 space-x-2">
                <button
                  onclick="openEditCategoryModal('<%= category.ID_CHINH_LM %>')"
                  class="bg-yellow-400 hover:bg-yellow-500 text-white px-3 py-2 rounded-md transition"
                >
                  ✏ Sửa
                </button>
                <button
                  onclick="confirmDeleteCategory('<%= category.ID_CHINH_LM %>')"
                  class="bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-md transition"
                >
                  🗑 Xóa
                </button>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-6 text-gray-400 italic">Không có loại món nào!</td>
          </tr>
        <% } %>
      </tbody>
    </table>

        <!-- Phân trang -->
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <div class="mt-6 flex justify-center space-x-2">
            <% if (currentPage > 1) { %>
              <a
                href="#"
                onclick="loadPage('/admin/loai-mon?page=<%= currentPage - 1 %>', document.querySelector('#content')); return false;"
                class="px-4 py-2 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition"
              >
                ‹ Trước
              </a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a
                href="#"
                onclick="loadPage('/admin/loai-mon?page=<%= i %>', document.querySelector('#content')); return false;"
                class="px-4 py-2 rounded-lg border text-sm <%= i === currentPage ? 'bg-yellow-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100' %>"
              >
                <%= i %>
              </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
              <a
                href="#"
                onclick="loadPage('/admin/loai-mon?page=<%= currentPage + 1 %>', document.querySelector('#content')); return false;"
                class="px-4 py-2 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition"
              >
                Sau ›
              </a>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- Modal Thêm/Sửa Loại Món -->
      <div id="categoryModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-md">
          <h2 id="modalTitle" class="text-2xl font-semibold mb-4 text-gray-800">Thêm Loại Món</h2>
      <form id="categoryForm" enctype="multipart/form-data" data-category-id="">
    <input type="hidden" id="categoryId" name="ID_CHINH_LM" />
            <div class="mb-4">
              <label for="tenLoai" class="block text-sm font-medium text-gray-700">Tên Loại Món</label>
              <input
                type="text"
                id="tenLoai"
                name="TEN_LM"
                class="mt-1 p-2 w-full border rounded-lg focus:ring-yellow-500 focus:border-yellow-500"
                required
              />
            </div>
            <div class="mb-4">
              <label for="slug" class="block text-sm font-medium text-gray-700">Slug</label>
              <input
                type="text"
                id="slug"
                name="SLUG_LM"
                class="mt-1 p-2 w-full border rounded-lg focus:ring-yellow-500 focus:border-yellow-500"
              />
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Hình Ảnh</label>
              <img
                id="imagePreview"
                src="/default.jpg"
                class="mt-2 w-40 h-40 object-cover rounded-lg border cursor-pointer"
                onclick="document.getElementById('hinhAnh').click()"
              />
              <input
                type="file"
                id="hinhAnh"
                name="hinh_anh"
                accept="image/*"
                class="hidden"
                onchange="previewImage(this, 'imagePreview')"
              />
            </div>
            <div class="flex justify-end space-x-2">
              <button
                type="button"
                onclick="closeCategoryModal()"
                class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition"
              >
                Hủy
              </button>
              <button
                type="submit"
                id="submitButton"
                class="px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition"
              >
                Thêm
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>


  </body>
  </html>
