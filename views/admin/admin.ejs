<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Quản lý Công Thức</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css" rel="stylesheet">
</head>
<body class="bg-[#FAF3E0] font-sans">
  <!-- Notification -->
  <div id="admin-notification" class="hidden fixed top-5 right-5 z-50 flex items-start gap-3 px-4 py-3 rounded-xl text-white shadow-xl transform transition-all duration-300 ease-in-out opacity-0"></div>

  <!-- Wrapper scale -->
  <div class="transform scale-80 origin-top-left">
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar -->
      <aside class="w-64 bg-gradient-to-b from-[#FFD700] to-[#DAA520] text-white p-6 shadow-xl flex flex-col fixed h-full border-r-4 z-10">
        <div class="mb-10">
          <h2 class="text-2xl font-extrabold text-center drop-shadow-md select-none">
            <a href="/admin">KemRepice</a>
          </h2>
        </div>
        <nav class="flex flex-col space-y-2 text-sm font-medium">
          <% const items = [
            // Thêm Trang Chủ vào đây
            { url: '/admin', icon: 'home', label: 'Trang Chủ', color: 'text-white' }, // Hoặc màu khác bạn muốn
            { url: '/admin/cong-thuc', icon: 'utensils', label: 'Công Thức', color: 'text-yellow-700' },
            { url: '/admin/nguyen-lieu', icon: 'seedling', label: 'Nguyên Liệu', color: 'text-green-600' },
            { url: '/admin/loai-mon', icon: 'bowl-rice', label: 'Loại Món', color: 'text-amber-600' },
            { url: '/admin/nguoi-dung', icon: 'user', label: 'Người Dùng', color: 'text-gray-700' },
            { url: '/admin/mon-an', icon: 'drumstick-bite', label: 'Món Ăn', color: 'text-orange-500' },
            { url: '/admin/yeu-thich', icon: 'heart', label: 'Yêu Thích', color: 'text-red-500' },
            { url: '/admin/danh-gia', icon: 'star', label: 'Đánh Giá', color: 'text-yellow-500' },
            { url: '/admin/binh-luan', icon: 'comment', label: 'Bình Luận', color: 'text-blue-600' },
            { url: '/admin/phan-hoi-binh-luan', icon: 'comments', label: 'Phản Hồi Bình Luận', color: 'text-blue-400' },
            { url: '/admin/binh-luan-cam-xuc', icon: 'face-smile', label: 'Cảm Xúc Bình Luận', color: 'text-pink-500' },
            { url: '/admin/phan-hoi-cam-xuc', icon: 'face-laugh-squint', label: 'Cảm Xúc Phản Hồi', color: 'text-purple-500' },
          ]; %>

          <% items.forEach(item => { %>
            <a href="<%= item.url %>" onclick="event.preventDefault(); loadPage('<%= item.url %>', this)"
               class="sidebar-item flex items-center gap-2 px-3 py-2 rounded-xl transition-all duration-200 hover:bg-yellow-600 text-white/90">
              <i class="fas fa-<%= item.icon %> <%= item.color %> text-base w-4 text-center"></i>
              <span><%= item.label %></span>
            </a>
          <% }) %>
        </nav>
      </aside>

      <!-- Content Area -->
      <div class="flex-1 ml-64 flex flex-col h-screen overflow-hidden">
        <!-- Header -->
        <header class="flex items-center justify-between bg-gradient-to-b from-[#FFD700] to-[#DAA520] p-3 border-b-4 shadow sticky top-0 z-30" style="height: 48px;">
          <div class="text-lg font-bold text-white select-none"></div>
          <div class="flex items-center space-x-4">
            <!-- Notification Button -->
  <div class="relative hidden md:flex items-center">
  <button id="notification-toggle" class="text-xl text-gray-700 hover:text-yellow-500 relative" aria-label="Thông báo">
    <i class="fa-solid fa-bell"></i>
    <span id="unread-notification-count"
      class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-4 w-4 flex items-center justify-center hidden">
    </span>
  </button>

  <!-- Dropdown -->
  <div id="notification-dropdown"
    class="absolute top-full right-0 mt-2 w-72 bg-white rounded-md shadow-md hidden z-50 max-h-80 overflow-y-auto border border-gray-200">
    <div class="p-3">
      <h3 class="text-base font-semibold text-gray-800 border-b pb-2 mb-2">Thông báo mới</h3>

      <!-- Danh sách thông báo sẽ được render ở đây -->
      <div id="notification-preview" class="space-y-3">
        <p class="text-sm text-gray-500 text-center">Đang tải thông báo...</p>
      </div>

      <div class="mt-4 text-center border-t pt-3">
        <a href="/admin/thong-bao"
          onclick="event.preventDefault(); loadPage('/admin/thong-bao', this)"
          class="block px-3 py-1 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 text-sm">
          Xem tất cả
        </a>
      </div>
    </div>
  </div>
</div>

            <!-- User Dropdown -->
            <div class="relative hidden md:block">
              <div id="user-avatar" class="flex items-center cursor-pointer space-x-1">
                <img src="<%= user.avatar || '/default-avatar.png' %>" class="w-8 h-8 rounded-full border-2 object-cover" alt="Avatar">
                <span class="font-semibold text-gray-700 truncate max-w-[100px] text-sm"><%= user.username %></span>
              </div>
              <div id="user-dropdown" class="absolute right-0 mt-2 w-40 bg-white rounded-md shadow-md hidden text-xs text-center">
                <a href="/admin/trang-ca-nhan" onclick="event.preventDefault(); loadPage('/admin/trang-ca-nhan', this)"
                   class="block px-3 py-1 hover:text-yellow-500">
                  <i class="fa-solid fa-user mr-1"></i>Thông tin cá nhân
                </a>
                <a href="/doi-mat-khau" onclick="event.preventDefault(); loadPage('/doi-mat-khau', this)"
                   class="block px-3 py-1 hover:text-yellow-500">
                  <i class="fa-solid fa-lock mr-1"></i>Đổi mật khẩu
                </a>
                <a href="/dang-xuat" class="block px-3 py-1 hover:text-yellow-500">
                  <i class="fa-solid fa-right-from-bracket mr-1"></i>Đăng xuất
                </a>
              </div>
            </div>
          </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 bg-white rounded-b-3xl p-6 overflow-auto shadow-inner z-0">
          <div id="content" class="w-full max-w-full h-full overflow-x-auto rounded-lg shadow-lg p-3">
            <% if (error) { %>
              <div class="bg-red-100 text-red-700 p-3 rounded mb-3"><%= error %></div>
            <% } %>

            <% if (content) { %>
              <%- include('../' + content) %>
            <% } else { %>
              <div class="text-center py-6 text-red-500">Không thể tải nội dung.</div>
            <% } %>
          </div>
        </main>
      </div>
    </div>
  </div>

  <!-- Custom CSS -->
  <style>
    .sidebar-item {
      display: block;
      transition: background-color 0.3s ease, transform 0.3s ease;
      color: white;
      background: rgba(255, 255, 255, 0.15);
      font-weight: 500;
      font-size: 0.9rem;
    }
    .sidebar-item:hover,
    .sidebar-item.active {
      background: rgba(255, 255, 255, 0.3);
      transform: translateX(6px);
      color: #FFF8DC;
      font-weight: 700;
      box-shadow: 0 3px 4px rgba(255, 255, 255, 0.3);
    }
 header {
  position: sticky;
  top: 0;
  z-index: 50;
  width: 100%;
  background: linear-gradient(to bottom, #FFD700, #DAA520);
}
  </style>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
  <script src="/admin/thongbao.js"></script>
  <script src="/admin/trangcanhan.js"></script>
  <script src="/admin/phanhoicamxuc.js"></script>
  <script src="/admin/binhluancamxuc.js"></script>
  <script src="/admin/phanhoibinhluan.js"></script>
  <script src="/admin/binhluan.js"></script>
  <script src="/admin/danhgia.js"></script>
  <script src="/admin/yeuthich.js"></script>
  <script src="/admin/nguoidung.js"></script>
  <script src="/admin/monan.js"></script>
  <script src="/admin/loaimon.js"></script>
  <script src="/admin/nguyenlieu.js"></script>
  <script src="/admin/script.js"></script>
</body>
</html>