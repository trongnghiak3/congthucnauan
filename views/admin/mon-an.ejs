<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản Lý Món Ăn</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>

<body class="p-4 font-sans bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <div class="mb-4 border-b border-gray-300">
      <ul class="flex space-x-2">
        <li>
          <button onclick="showTab('dishes')" id="tab-dishes"
            class="tab-button px-3 py-1 rounded-t-lg font-semibold bg-yellow-500 text-white shadow-md hover:bg-yellow-600 focus:outline-none text-sm"
            aria-selected="true" role="tab">
            Danh Sách Món Ăn
          </button>
        </li>
        <li>
          <button onclick="showTab('dishes-by-category')" id="tab-dishes-by-category"
            class="tab-button px-3 py-1 rounded-t-lg font-semibold bg-gray-200 text-gray-600 hover:bg-gray-300 focus:outline-none text-sm"
            aria-selected="false" role="tab">
            Danh Sách Món Ăn Theo Loại Món
          </button>
        </li>
      </ul>
    </div>

    <div id="dishes" class="tab-content" role="tabpanel" aria-labelledby="tab-dishes">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-2 sm:space-y-0 mb-4">
        <div class="w-full sm:w-1/3 md:w-1/4 lg:w-1/5 flex-shrink-0">
          <label for="dishSearchInput" class="sr-only">Tìm kiếm món ăn</label>
          <input type="text" id="dishSearchInput" placeholder="Tìm kiếm..."
            value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>"
            class="w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition" />
        </div>

        <div class="w-full sm:w-1/4 md:w-1/5 lg:w-1/6 flex-shrink-0 sm:ml-4">
          <label for="dishTypeFilter" class="sr-only">Lọc theo Loại Món</label>
          <select id="dishTypeFilter"
            class="w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition">
            <option value="">Loại Món</option>
            <% if (typeof categories !=='undefined' && categories.length> 0) { %>
            <% categories.forEach(type=> { %>
            <option value="<%= type.ID_CHINH_LM %>" <%=typeof selectedTypeId !=='undefined' &&
              selectedTypeId==type.ID_CHINH_LM ? 'selected' : '' %>>
              <%= type.TEN_LM %>
            </option>
            <% }) %>
            <% } %>
          </select>
        </div>

        <div class="flex space-x-2 w-full sm:w-auto justify-end sm:ml-4">
          <button onclick="applyDishFilters()"
            class="px-3 py-1.5 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition duration-200 text-sm flex-shrink-0">
            Lọc
          </button>
          <button onclick="resetDishFilters()"
            class="px-3 py-1.5 bg-gray-400 text-white rounded-lg hover:bg-gray-500 transition duration-200 text-sm flex-shrink-0">
            Đặt Lại
          </button>
          <button onclick="openAddDishModal()"
            class="px-3 py-1.5 bg-yellow-500 text-white rounded-lg hover:bg-green-600 transition duration-200 text-sm flex-shrink-0">
            ➕ Thêm
          </button>
        </div>
      </div>
      <table class="min-w-full border border-gray-300 rounded-lg overflow-hidden shadow-sm bg-white">
        <thead class="bg-gray-100 text-gray-700 uppercase text-xs font-semibold">
          <tr>
            <th class="px-4 py-2 text-left border-r border-gray-300">STT</th>
            <th class="px-4 py-2 text-left border-r border-gray-300">Tên Món Ăn</th>
            <th class="px-4 py-2 text-left border-r border-gray-300">Loại Món</th>
            <th class="px-4 py-2 text-left border-r border-gray-300">Mô Tả</th>
            <th class="px-4 py-2 text-left border-r border-gray-300">Hình Ảnh</th>
            <th class="px-4 py-2 text-left">Hành Động</th>
          </tr>
        </thead>
        <tbody class="text-gray-800 text-sm" id="dishTableBody">
          <% if (monAnList && monAnList.length> 0) { %>
          <%
            const itemsPerPage = 8; // Assuming 8 items per page based on the original pagination
            const startIndex = (currentPage - 1) * itemsPerPage;
          %>
          <% monAnList.forEach((dish, index)=> { %>
          <tr class="hover:bg-yellow-50 transition duration-200 dish-row">
            <td class="px-4 py-2 border-t border-gray-200 dish-stt">
              <%= startIndex + index + 1 %>
            </td>
            <td class="px-4 py-2 border-t border-gray-200">
              <%= dish.TEN_MON_AN %>
            </td>
            <td class="px-4 py-2 border-t border-gray-200 dish-type">
              <%
    let dishTypes = 'Không rõ';
    if (groupedMonAnTheoLoai[dish.ID_CHINH_MA] && groupedMonAnTheoLoai[dish.ID_CHINH_MA].loai_mon.length > 0) {
      const uniqueTypes = [...new Set(groupedMonAnTheoLoai[dish.ID_CHINH_MA].loai_mon.map(lm => lm.TEN_LM))];
      dishTypes = uniqueTypes.join(', ');
    }
%>
              <span class="dish-type-text"><%= dishTypes %></span>

            </td>

            </td>
            <td class="px-4 py-2 border-t border-gray-200 line-clamp-2 dish-description">
              <%= dish.MO_TA_MA || 'Không có' %>
            </td>
            <td class="px-4 py-2 border-t border-gray-200">
              <% if (dish.HINH_ANH_MA) { %>
              <a href="<%= dish.HINH_ANH_MA %>" target="_blank">
                <img src="<%= dish.HINH_ANH_MA %>" alt="Ảnh món ăn"
                  class="w-12 h-12 object-cover rounded shadow-sm hover:scale-105 transition transform" />
              </a>
              <% } else { %>
              <span class="text-gray-400 italic">Không có</span>
              <% } %>
            </td>
            <td class="px-4 py-2 border-t border-gray-200 space-x-1.5">
              <button onclick="openEditDishModal('<%= dish.ID_CHINH_MA %>')"
                class="bg-yellow-400 hover:bg-yellow-500 text-white px-2.5 py-1.5 rounded-md transition text-xs">
                ✏ Sửa
              </button>
              <button onclick="confirmDeleteDish('<%= dish.ID_CHINH_MA %>')"
                class="bg-red-600 hover:bg-red-700 text-white px-2.5 py-1.5 rounded-md transition text-xs">
                🗑 Xóa
              </button>
            </td>
          </tr>
          <% }) %>
          <% } else { %>
          <tr class="no-dish-found-message">
            <td colspan="6" class="text-center py-4 text-gray-400 italic text-sm">Không có món ăn nào để hiển
              thị.</td>
          </tr>
          <% } %>
        </tbody>
      </table>

      <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
      <div class="mt-4 flex justify-center space-x-2">
        <% if (currentPage> 1) { %>
        <a href="#"
          onclick="loadPage('/admin/mon-an?page=<%= currentPage - 1 %>&pageCategories=<%= currentPageCategories %>', document.querySelector('#content')); return false;"
          class="px-3 py-1 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 text-sm transition">
          ‹ Trước
        </a>
        <% } %>

        <% for (let i=1; i <=totalPages; i++) { %>
        <a href="#"
          onclick="loadPage('/admin/mon-an?page=<%= i %>&pageCategories=<%= currentPageCategories %>', document.querySelector('#content')); return false;"
          class="px-3 py-1 rounded-lg border text-sm <%= i === currentPage ? 'bg-yellow-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100' %> transition">
          <%= i %>
        </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
        <a href="#"
          onclick="loadPage('/admin/mon-an?page=<%= currentPage + 1 %>&pageCategories=<%= currentPageCategories %>', document.querySelector('#content')); return false;"
          class="px-3 py-1 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 text-sm transition">
          Sau ›
        </a>
        <% } %>
      </div>
      <% } %>

    </div>
    <div id="dishes-by-category" class="tab-content hidden" role="tabpanel" aria-labelledby="tab-dishes-by-category">
      <div class="flex flex-col md:flex-row justify-between items-center px-4 py-2 bg-white border-b border-gray-200">
        <div class="w-full md:w-1/2 mb-2 md:mb-0">
          <input type="text" id="searchDish" onkeyup="filterDishes()" placeholder="Tìm kiếm món ăn..."
            class="w-full border border-gray-300 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-yellow-400 transition" />
        </div>
        <div class="text-gray-600 text-xs">

          <p class="text-sm text-gray-600">Tổng loại món có món ăn: <%= tongLoaiMonCoMon %>
          </p>
          </span>
        </div>
      </div>
      <div class="overflow-x-auto px-4 py-2 bg-white rounded-b-lg border border-t-0 border-gray-200">
        <table class="min-w-full text-sm text-gray-700">
          <thead>
            <tr class="bg-gray-100 text-gray-700 uppercase text-xs font-medium select-none">
              <th class="px-4 py-2 border-r border-gray-300 text-center">STT</th>
              <th class="px-4 py-2 border-r border-gray-300 text-left">Tên Món Ăn</th>
              <th class="px-4 py-2 border-r border-gray-300 text-left">Mô Tả</th>
            </tr>
          </thead>
          <tbody>
            <% if (groupedLoaiMon && Object.keys(groupedLoaiMon).length> 0) { %>
            <% let totalIndex=0; %> <% Object.entries(groupedLoaiMon).forEach(([typeId, data], index)=> { %>
            <tr onclick="toggleDishes('<%= typeId %>')"
              class="cursor-pointer bg-gray-50 hover:bg-yellow-100 category-row">
              <td colspan="3" class="px-4 py-2 font-semibold text-center border-t border-gray-200 text-gray-800">
                🍽 <%= data.TEN_LM %>
              </td>
            </tr>
            <% if (data.mon_an && data.mon_an.length> 0) { %>
            <% data.mon_an.forEach((dish, idx)=> { %>
            <% totalIndex++; %>
            <tr class="dish-row hidden" data-group="<%= typeId %>">
              <td class="p-2 text-center">
                <%= totalIndex %>
              </td>
              <td class="p-2 text-left">
                <%= dish.TEN_MON_AN %>
              </td>
              <td class="p-2 text-left">
                <%= dish.MO_TA_MA || 'Không có mô tả' %>
              </td>
            </tr>
            <% }) %>
            <% } else { %>
            <tr class="hidden">
              <td colspan="3" class="text-center text-gray-400 italic">Không có món ăn nào trong loại
                này.</td>
            </tr>
            <% } %>
            <% }) %>
            <% } else { %>
            <tr>
              <td colspan="3" class="text-center py-4 text-gray-400 italic">Không có món ăn nào!
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if (typeof totalPagesCategories !=='undefined' && totalPagesCategories> 1) { %>
      <div class="mt-4 flex justify-center space-x-2">
        <% if (currentPageCategories> 1) { %>
        <a href="#"
          onclick="loadPage('/admin/mon-an?page=<%= currentPage %>&pageCategories=<%= currentPageCategories - 1 %>', document.querySelector('#content')); return false;"
          class="px-3 py-1 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition text-sm">
          ‹ Trước
        </a>
        <% } %>
        <% for (let i=1; i <=totalPagesCategories; i++) { %>
        <a href="#"
          onclick="loadPage('/admin/mon-an?page=<%= currentPage %>&pageCategories=<%= i %>', document.querySelector('#content')); return false;"
          class="px-3 py-1 rounded-lg border text-sm <%= i === currentPageCategories ? 'bg-yellow-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100' %>">
          <%= i %>
        </a>
        <% } %>
        <% if (currentPageCategories < totalPagesCategories) { %>
        <a href="#"
          onclick="loadPage('/admin/mon-an?page=<%= currentPage %>&pageCategories=<%= currentPageCategories + 1 %>', document.querySelector('#content')); return false;"
          class="px-3 py-1 rounded-lg border bg-white text-gray-700 hover:bg-gray-100 transition text-sm">
          Sau ›
        </a>
        <% } %>
      </div>
      <% } %>
    </div>




    <div id="dishModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
      <div class="bg-white p-4 rounded-lg shadow-lg w-full max-w-sm">
        <h2 id="modalTitle" class="text-lg font-semibold mb-3 text-gray-800">Thêm Món Ăn</h2>
        <form id="dishForm" enctype="multipart/form-data" data-dish-id="">
          <input type="hidden" id="dishId" name="ID_CHINH_MA" />
          <div class="mb-3">
            <label for="tenMonAn" class="block text-sm font-medium text-gray-700">Tên Món Ăn</label>
            <input type="text" id="tenMonAn" name="TEN_MON_AN"
              class="mt-1 p-1.5 w-full border rounded-lg focus:ring-yellow-500 focus:border-yellow-500 text-sm"
              required />
          </div>
          <div class="mb-3">
            <label for="loaiMon" class="block text-sm font-medium text-gray-700">Loại Món</label>
            <select id="loaiMon" name="ID_CHINH_LM" multiple
              class="mt-1 p-1.5 w-full border rounded-lg focus:ring-yellow-500 focus:border-yellow-500 text-sm"
              required>
              <option value="">Chọn loại món</option>
              <% if (categories && categories.length> 0) { %>
              <% categories.forEach(category=> { %>
              <option value="<%= category.ID_CHINH_LM %>">
                <%= category.TEN_LM %>
              </option>
              <% }) %>
              <% } %>
            </select>
          </div>
          <div class="mb-3">
            <label for="moTa" class="block text-sm font-medium text-gray-700">Mô Tả</label>
            <textarea id="moTa" name="MO_TA_MA"
              class="mt-1 p-1.5 w-full border rounded-lg focus:ring-yellow-500 focus:border-yellow-500 text-sm"></textarea>
          </div>
          <div class="mb-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Hình Ảnh</label>
            <img id="imagePreview" src="/default.jpg"
              class="mt-1 w-28 h-28 object-cover rounded-lg border cursor-pointer"
              onclick="document.getElementById('hinhAnh').click()" />
            <input type="file" id="hinhAnh" name="hinh_anh" accept="image/*" class="hidden"
              onchange="previewImage(this, 'imagePreview')" />
          </div>
          <div class="flex justify-end space-x-2">
            <button type="button" onclick="closeDishModal()"
              class="px-3 py-1 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition text-sm">
              Hủy
            </button>
            <button type="submit" id="submitButton"
              class="px-3 py-1 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition text-sm">
              Thêm
            </button>
          </div>
        </form>
      </div>
    </div>

    <style>
      .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .hidden {
        display: none;
      }

      .category-row.active {
        background-color: #fefcbf;
        /* Màu nền khi mở, có thể tùy chỉnh */
      }
    </style>

</body>

</html>