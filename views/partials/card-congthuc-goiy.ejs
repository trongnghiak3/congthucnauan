<%
  const totalMinutes = parseInt(recipe.THOI_GIAN_NAU) || 0;
  let timeDisplay = "";
  if (totalMinutes >= 60) {
    const hours = Math.floor(totalMinutes / 60);
    const mins = totalMinutes % 60;
    timeDisplay = `${hours} giờ${mins > 0 ? ' ' + mins + ' phút' : ''}`;
  } else if (totalMinutes > 0) {
    timeDisplay = `${totalMinutes} phút`;
  } else {
    timeDisplay = "Chưa có";
  }

  const difficulty = recipe.DO_KHO || "Chưa có";

  // Xử lý đánh giá
  let ratingDisplay = "Chưa có";
  if (recipe.DANH_GIA !== undefined && recipe.DANH_GIA !== null && recipe.DANH_GIA !== "") {
    ratingDisplay = parseFloat(recipe.DANH_GIA).toFixed(1); // giữ định dạng 4.0, 5.0,...
  }
%>

<div class="recipe-card bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer group"
     data-category-id="<%= recipe.loai_mon_ids || '' %>"
     data-portion="<%= recipe.SO_PHAN_AN || '2-4' %>"
     data-time="<%= Math.floor(recipe.THOI_GIAN_NAU / 60) || 0 %>"
     data-difficulty="<%= recipe.DO_KHO || 'Chưa có' %>"
     onclick="window.location.href='/cong-thuc/<%= recipe.ID_CHINH_CT %>'">
  
  <div class="relative h-24 overflow-hidden">
    <% if (recipe.HINH_ANH_CT) { %>
      <img src="<%= recipe.HINH_ANH_CT %>" 
           alt="<%= recipe.TEN_CT %>" 
           class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-in-out" />
    <% } else { %>
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-50 to-gray-100 text-gray-400 text-sm font-medium">
        <i class="fas fa-image mr-2 text-lg"></i>Không có ảnh
      </div>
    <% } %>

    <span class="absolute top-2 left-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white text-xs font-semibold px-2 py-1 rounded-full shadow-sm">
      <% if (recipe.categories && recipe.categories.length > 0) { %>
        <%= recipe.categories.join(', ') %>
      <% } else { %>
        Không có danh mục
      <% } %>
    </span>
<div class="absolute bottom-3 right-3 bg-black bg-opacity-70 text-white text-xs font-semibold px-3 py-1 rounded-full flex items-center shadow-md">
  <i class="fas fa-star text-yellow-400 mr-1.5 text-xs"></i>
  <%= ratingDisplay %>
</div>

  </div>

  <div class="p-3 space-y-2">
    <h3 class="text-base font-semibold text-gray-800 truncate leading-tight group-hover:text-amber-600 transition-colors duration-300">
      <%= recipe.TEN_CT %>
    </h3>

    <div class="flex flex-wrap justify-between items-center text-xs text-gray-600 font-medium">
      <span class="flex items-center mb-1"><i class="fas fa-clock mr-1 text-amber-500"></i><%= timeDisplay %></span>
      <span class="flex items-center mb-1"><i class="fas fa-fire mr-1 text-red-500"></i><%= difficulty %></span>
      <span class="flex items-center"><i class="fas fa-utensils mr-1 text-green-500"></i><%= recipe.SO_PHAN_AN || '2-4' %> người</span>
    </div>
  </div>
</div>