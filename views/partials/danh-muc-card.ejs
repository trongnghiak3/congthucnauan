<a href="/danh-muc/<%= cat.SLUG_LM %>" 
   class="group block bg-white rounded-2xl overflow-hidden shadow hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">

  <% if (cat.HINH_ANH_LM_URL) { %>
    <div class="h-44 overflow-hidden">
      <img src="<%= cat.HINH_ANH_LM_URL %>" alt="<%= cat.TEN_LM %>" 
           class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
    </div>
  <% } else { %>
    <div class="w-full h-44 bg-gray-100 flex items-center justify-center text-gray-400 text-sm">
      <i class="fas fa-image mr-1.5"></i> Không có ảnh
    </div>
  <% } %>

  <div class="p-4 text-center bg-white">
    <h3 class="text-lg font-bold text-gray-800 group-hover:text-amber-600 transition-colors">
      <%= cat.TEN_LM %>
    </h3>
  </div>
</a>
