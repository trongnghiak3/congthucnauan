  <%
    // Helper function để chuyển đổi thời gian nấu
    const formatTime = (totalMinutes) => {
      totalMinutes = parseInt(totalMinutes) || 0;
      if (totalMinutes >= 60) {
        const hours = Math.floor(totalMinutes / 60);
        const mins = totalMinutes % 60;
        return `${hours} giờ${mins > 0 ? ' ' + mins + ' phút' : ''}`;
      }
      return totalMinutes > 0 ? `${totalMinutes} phút` : "Chưa có";
    };

    // Helper function để tạo chuỗi sao đánh giá
    const renderStars = (rating) => {
      const hasRating = !isNaN(rating) && rating > 0;
      if (!hasRating) {
        return `<i class="fas fa-star text-yellow-400 mr-1.5 text-xs"></i><span>Chưa có</span>`;
      }
      const fullStars = Math.floor(rating);
      const halfStar = rating % 1 >= 0.5;
      let stars = '';
      for (let i = 0; i < fullStars; i++) stars += '<i class="fas fa-star text-yellow-400"></i>';
      if (halfStar) stars += '<i class="fas fa-star-half-alt text-yellow-400"></i>';
      for (let i = 0; i < 5 - fullStars - (halfStar ? 1 : 0); i++) stars += '<i class="far fa-star text-yellow-400"></i>';
      return `${stars}<span class="ml-1">${rating.toFixed(1)}</span>`;
    };

    const timeDisplay = formatTime(recipe.THOI_GIAN_NAU);
    const difficulty = recipe.DO_KHO || "Chưa có";
    const description = recipe.MOTA || 'Chưa có mô tả ngắn.';
  %>

<a href="/cong-thuc/<%= recipe.ID_CHINH_CT %>" 
   class="recipe-card group flex flex-col sm:flex-row bg-white rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden cursor-pointer"
   data-id="<%= recipe.ID_CHINH_CT %>">

  <div class="relative w-full h-48 sm:w-56 sm:h-56 lg:w-64 lg:h-64 flex-shrink-0 overflow-hidden">
    <% if (recipe.HINH_ANH_CT) { %>
      <img src="<%= recipe.HINH_ANH_CT %>" 
           alt="<%= recipe.TEN_CT %>" 
           class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500 ease-in-out" />
    <% } else { %>
      <div class="w-full h-full flex items-center justify-center bg-gray-200 text-gray-400 text-sm font-medium animate-pulse">
        <i class="fas fa-image mr-2 text-xl"></i>Không có ảnh
      </div>
    <% } %>
    <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>

    <span class="absolute top-3 left-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white text-xs font-semibold px-3 py-1 rounded-full shadow-lg">
      <%= recipe.TEN_MON_AN %>
    </span>

    <div class="absolute bottom-3 right-3 bg-black bg-opacity-70 text-white text-xs font-semibold px-2 py-1 rounded-full flex items-center shadow-lg">
      <%- renderStars(parseFloat(recipe.DANH_GIA)) %>
    </div>
  </div>

  <div class="flex-1 p-4 sm:p-5 lg:p-6 flex flex-col justify-between">
    <h3 class="text-base sm:text-lg lg:text-xl font-bold text-gray-800 line-clamp-2 group-hover:text-amber-600 transition-colors duration-300"
        title="<%= recipe.TEN_CT %>">
      <%= recipe.TEN_CT %>
    </h3>
<p class="text-xs sm:text-sm text-gray-500 mt-2 mb-3 h-20 overflow-y-auto" 
   title="<%= description %>">
  <%= description %>
</p>

    <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs sm:text-sm text-gray-600 font-medium pt-3 border-t border-gray-200">
      <span class="flex items-center gap-1"><i class="fas fa-clock text-amber-500"></i> <%= timeDisplay %></span>
      <span class="flex items-center gap-1"><i class="fas fa-fire text-red-500"></i> <%= difficulty %></span>
      <span class="flex items-center gap-1"><i class="fas fa-utensils text-green-500"></i> <%= recipe.SO_PHAN_AN %> người</span>
    </div>
  </div>
</a>

